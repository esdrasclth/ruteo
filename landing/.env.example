# Dominio del panel (proyecto ../frontend). La landing enlaza aquí para
# /track, /login y /register, que no existen en este proyecto.
# En desarrollo el panel corre en el puerto 3001.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Dominio propio de la landing. Lo usa el marcado JSON-LD, que necesita URLs
# absolutas. En desarrollo la landing corre en el puerto 3003.
NEXT_PUBLIC_SITE_URL=http://localhost:3003
