# Contenido de la pestaña «Environment» de la aplicación Compose en Dokploy.
#
# NO es un archivo que se copie al VPS: se pega tal cual en la interfaz, que lo
# escribe junto al compose y `docker compose` lo usa para interpolar los
# `${...}` de `docker-compose.dokploy.yml`. Por eso aquí no hay secretos de
# verdad ni este archivo debe llevarlos nunca.
#
# Todo lo que no tenga valor por defecto en el compose es OBLIGATORIO: si falta,
# el despliegue se para con «define X en el Environment de Dokploy» en vez de
# levantar a medias.

# --- Dominios -----------------------------------------------------------------
# Las cuatro salen del mismo sitio y se confunden con facilidad:
#
#   PUBLIC_SITE_URL     landing        lo que ve un visitante
#   PUBLIC_PANEL_URL    panel          a donde enlaza la landing y los correos
#   PUBLIC_BACKEND_URL  api SIN /api   base de los enlaces QR de rastreo
#   PUBLIC_API_URL      api CON /api   a donde llama el JavaScript del panel
#
# Las tres `PUBLIC_*` que consumen el panel y la landing se INCRUSTAN en el
# bundle al construir. Cambiarlas exige reconstruir la imagen, no basta con
# reiniciar.
PUBLIC_SITE_URL=https://ruteo.brandsofts.com
PUBLIC_PANEL_URL=https://panel.ruteo.brandsofts.com
PUBLIC_BACKEND_URL=https://api.ruteo.brandsofts.com
PUBLIC_API_URL=https://api.ruteo.brandsofts.com/api

# --- Acceso por subdominio ----------------------------------------------------
# Cada empresa entra por `<slug>.ruteo.brandsofts.com`. El slug ya no se teclea
# en el login: se deduce del host.
#
# `PUBLIC_PANEL_BASE_HOST` es solo el dominio, sin esquema: de él se recorta el
# slug en el navegador.
PUBLIC_PANEL_BASE_HOST=ruteo.brandsofts.com
# `PUBLIC_PANEL_TENANT_URL` lleva esquema y el marcador {slug}. Alimenta los
# enlaces de los correos y la lista de origenes que acepta el CORS. El arranque
# aborta si le falta el {slug} o si no es https.
PUBLIC_PANEL_TENANT_URL=https://{slug}.ruteo.brandsofts.com

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=ruteo
POSTGRES_DB=ruteo
# openssl rand -base64 32
POSTGRES_PASSWORD=

# Cadenas de conexión DENTRO de la red del compose: el host es `db`, el nombre
# del servicio. Con `localhost` el backend buscaría Postgres dentro de sí mismo
# y moriría con un P1001 que no explica nada.
#
# Las contraseñas son las que se rotan DESPUÉS de la primera migración (ver
# docs/despliegue-dokploy.md); el arranque aborta si detecta las de por defecto.
#
# OJO: si la contraseña lleva `@`, `/`, `:` o `#`, hay que codificarla en la URL
# o la cadena se parte por donde no es. `openssl rand -base64` puede producir
# `/` y `+`.
DATABASE_URL_DOCKER=postgresql://ruteo:<rotada>@db:5432/ruteo?schema=public
DATABASE_URL_APP_DOCKER=postgresql://ruteo_app:<rotada>@db:5432/ruteo?schema=public

# --- Redis --------------------------------------------------------------------
# Obligatoria: el backend se niega a arrancar sin ella.
# openssl rand -base64 32
REDIS_PASSWORD=

# --- Secretos de sesión -------------------------------------------------------
# Los TRES distintos entre sí. Compartir el de plataforma con los de tenant
# anula la separación del panel de superadmin: quien falsifique un token de
# empresa falsifica el que las ve todas.
# openssl rand -base64 48   (uno por línea, no el mismo tres veces)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PLATFORM_JWT_SECRET=

# --- Identidad (ZITADEL) ------------------------------------------------------
ZITADEL_ISSUER=https://auth.brandsofts.com
# Cuenta de servicio con permisos de Management API (PAT).
ZITADEL_SERVICE_TOKEN=
# Proyecto cuyos roles se mapean a los `Role` de Ruteo. Opcional.
ZITADEL_PROJECT_ID=

# --- Correo saliente ----------------------------------------------------------
# Sin esto, los códigos de restablecimiento y verificación salen por el log en
# vez de enviarse: en producción es una cuenta que nadie puede recuperar.
RESEND_API_KEY=
MAIL_FROM=Ruteo <no-reply@brandsofts.com>

# --- Opcionales con valor por defecto en el compose ---------------------------
# JWT_ACCESS_TTL=900s
# JWT_REFRESH_TTL=7d
# QUEUE_PREFIX=bull
# NOMINATIM_USER_AGENT=Ruteo/1.0 (logistica; contacto: soporte@brandsofts.com)
