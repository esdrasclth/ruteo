# Infraestructura del docker-compose (Postgres + Redis + OSRM).
#
# Los tres servicios publican sus puertos SOLO en 127.0.0.1 (ver comentario en
# docker-compose.yml: las reglas de Docker se saltan UFW). Estos valores son la
# parte que cambia por entorno.

# Postgres
POSTGRES_USER=ruteo
# En local vale cualquier cosa. En el VPS: openssl rand -base64 32
POSTGRES_PASSWORD=ruteo
POSTGRES_DB=ruteo
POSTGRES_PORT=5544

# Redis
REDIS_PORT=6379
# Vacía en local: el contenedor arranca sin --requirepass y todo funciona igual.
# OBLIGATORIA en producción; el backend se niega a arrancar sin ella.
#   openssl rand -base64 32
REDIS_PASSWORD=

# OSRM (motor de rutas por carretera)
OSRM_PORT=5100


# =============================================================================
# Solo para `docker-compose.prod.yml`. En desarrollo no hace falta nada de esto.
# =============================================================================

# --- Cadenas de conexión DENTRO de la red de Compose --------------------------
# Son distintas de las de `backend/.env`: allí el host es `localhost` porque el
# backend corre en la máquina; aquí es `db`, el nombre del servicio. Con las de
# `backend/.env`, el contenedor buscaría Postgres dentro de sí mismo.
#
# Las contraseñas son las que se rotan DESPUÉS de migrar (ver
# docs/despliegue-vps.md); el arranque aborta si detecta las de por defecto.
DATABASE_URL_DOCKER="postgresql://ruteo:<rotada>@db:5432/ruteo?schema=public"
DATABASE_URL_APP_DOCKER="postgresql://ruteo_app:<rotada>@db:5432/ruteo?schema=public"

# --- URLs públicas ------------------------------------------------------------
# OJO: estas tres se INCRUSTAN en el JavaScript del navegador al construir las
# imágenes, no se leen al arrancar. Cambiar cualquiera obliga a reconstruir:
#   docker compose -f docker-compose.prod.yml up -d --build
# Ponerlas en el `environment` de un contenedor ya construido no hace nada.

# A dónde llama el panel. Incluye el prefijo /api.
PUBLIC_API_URL=https://api.tu-dominio/api
# A dónde enlaza la landing para entrar al panel.
PUBLIC_PANEL_URL=https://panel.tu-dominio
# Dominio propio de la landing; alimenta el JSON-LD, que necesita URLs absolutas.
PUBLIC_SITE_URL=https://tu-dominio

# --- Puertos en el host -------------------------------------------------------
# Solo en loopback: delante va el proxy que termina TLS. Postgres, Redis y OSRM
# no se publican en producción, ni siquiera en loopback.
BACKEND_PORT=3000
FRONTEND_PORT=3001
LANDING_PORT=3003
