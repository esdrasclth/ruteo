# Infraestructura del docker-compose (Postgres + Redis + OSRM).
#
# Los tres servicios publican sus puertos SOLO en 127.0.0.1 (ver comentario en
# docker-compose.yml: las reglas de Docker se saltan UFW). Estos valores son la
# parte que cambia por entorno.

# Postgres
POSTGRES_USER=ruteo
# En local vale cualquier cosa. En el VPS: openssl rand -base64 32
POSTGRES_PASSWORD=ruteo
POSTGRES_DB=ruteo
POSTGRES_PORT=5544

# Redis
REDIS_PORT=6379
# Vacía en local: el contenedor arranca sin --requirepass y todo funciona igual.
# OBLIGATORIA en producción; el backend se niega a arrancar sin ella.
#   openssl rand -base64 32
REDIS_PASSWORD=

# OSRM (motor de rutas por carretera)
OSRM_PORT=5100
