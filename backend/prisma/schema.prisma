generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum Role {
  OWNER
  ADMIN
  OPERATOR
  DRIVER
  MERCHANT
  SUPPORT
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ShipmentType {
  LOCAL
  INTERNATIONAL
}

enum ShipmentStatus {
  CREATED
  // local milestones
  LABEL_GENERATED
  PICKED_UP
  IN_TRANSIT
  // international milestones (USA -> HN)
  RECEIVED_USA
  CONSOLIDATED
  IN_TRANSIT_INTL
  IN_CUSTOMS_HN
  CUSTOMS_CLEARED
  IN_WAREHOUSE_HN
  // shared last mile
  OUT_FOR_DELIVERY
  DELIVERED
  // branches
  FAILED_ATTEMPT
  RETURNED
  CANCELLED
  ON_HOLD_CUSTOMS
}

/// Que clase de hecho registra un `ShipmentEvent`.
///
/// **Solo hay valores con productor escrito.** Mismo criterio que la fase 0.1
/// tuvo con las categorias de archivo: un tipo que nadie emite es una promesa
/// que el sistema no cumple, y el dia que alguien lo necesite no sabra si esta
/// vacio porque no pasa nunca o porque nadie lo cableo.
enum ShipmentEventType {
  /// El cambio de estado de siempre. Es el unico que lleva `status`.
  STATUS_CHANGED
  /// Se liquido la aduana: valor aduanero, arancel e impuesto.
  CUSTOMS_ASSESSED
  /// Se libero de aduana. No cambia el estado del envio —la transicion es
  /// aparte— asi que sin este evento la liberacion no dejaba ningun rastro.
  CUSTOMS_CLEARED
  DOCUMENT_ADDED
  /// Alguien lo miro y dice que sirve, que no es lo mismo que haberlo subido.
  DOCUMENT_VERIFIED
  CHARGE_ADDED
  CHARGE_COLLECTED
  EXCEPTION_OPENED
  EXCEPTION_RESOLVED
  /// Posventa. Van en el historial del envio y no solo en la tabla del reclamo
  /// porque la pregunta que se hace de verdad es «que paso con este bulto», y
  /// responderla obligaria a mirar en cinco sitios distintos.
  CLAIM_OPENED
  /// Aprobado o rechazado: el desenlace va en el `metadata`.
  CLAIM_RESOLVED
  RETURN_STARTED
  RETURN_COMPLETED
  REFUND_ISSUED
  /// Nota a mano del operador. Es la valvula de escape: lo que pasa de verdad y
  /// no encaja en ningun tipo acaba escrito en algun sitio, y mejor aqui que en
  /// un WhatsApp.
  NOTE
}

/// Quien puede ver un evento.
///
/// Con esto la misma tabla alimenta las dos pantallas: el cliente ve sus hitos
/// mas lo marcado como publico, y el operador lo ve todo.
enum EventVisibility {
  INTERNAL
  PUBLIC
}

enum LegMode {
  AIR
  SEA
  GROUND
}

enum LegStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum CarrierType {
  COURIER
  AIRLINE
  OCEAN
  GROUND
}

enum LockerStatus {
  ACTIVE
  SUSPENDED
}

enum PackageStatus {
  PRE_ALERTED
  RECEIVED
  CONSOLIDATED
  SHIPPED
}

/// En qué estado llegó el bulto a la bodega.
///
/// Se registra SIEMPRE, aunque sea `GOOD`: «no se anotó nada» y «se revisó y
/// estaba bien» son cosas distintas el día que alguien reclama, y sin un valor
/// por defecto explícito no hay forma de distinguirlas.
enum PackageCondition {
  GOOD
  DAMAGED
  WET
  OPENED
}

/// Qué hay dentro, a ojos de la operación.
///
/// **No es una clasificación arancelaria.** Es la que usa el operador para
/// decidir si algo necesita revisión y para que la fase 3 sepa qué documentos
/// pedir. Las partidas y los límites de aduana van en `CustomsRule`, que se
/// versiona por fechas porque la normativa cambia; esta lista no.
enum PackageCategory {
  ELECTRONICS
  CLOTHING
  FOOTWEAR
  HOME
  AUTO_PARTS
  COSMETICS
  MEDICINE
  DOCUMENTS
  OTHER
}

/// Qué papel juega una bodega en la operación.
/// Como llega el paquete a manos del destinatario.
///
/// Se elige ANTES de que el paquete llegue, no al descargarlo: es lo que decide
/// en que monton va el bulto en la bodega de destino. Descubrirlo con la caja
/// ya en la mano obliga a volver a tocarla, que es justo lo que la
/// clasificacion existe para evitar.
enum DeliveryMode {
  /// A domicilio, con repartidor y ruta.
  HOME
  /// El cliente lo retira en una sucursal propia.
  BRANCH
  /// Punto de entrega de un tercero (pulperia, farmacia, casillero publico).
  PICKUP_POINT
}

enum WarehouseType {
  /// Donde se recibe del comercio: Miami, típicamente.
  ORIGIN
  /// Donde llega la carga y se desconsolida: la del país de destino.
  DESTINATION
  /// Sucursal donde el cliente puede retirar.
  BRANCH
}

/// Estado del viaje que transporta la carga.
enum TripStatus {
  PLANNED
  IN_TRANSIT
  ARRIVED
  CANCELLED
}

/// Estado del manifiesto.
///
/// `RECONCILED` es el que importa: significa que lo declarado se contó contra lo
/// que llegó de verdad. Sin ese paso, el manifiesto es una lista de intenciones.
enum ManifestStatus {
  DRAFT
  TRANSMITTED
  ARRIVED
  RECONCILED
}

/// Qué salió mal.
///
/// La lista es cerrada a propósito: una excepción con el motivo en texto libre
/// no se puede contar, y lo primero que se pregunta al final del mes es cuántos
/// faltantes hubo.
enum ExceptionType {
  /// Lo manifestado no cuadra con lo recibido. Ver `ManifestsService.cotejar`.
  MANIFEST_MISMATCH
  /// Llegaron menos bultos de los declarados.
  MISSING
  /// Llegaron más. También es un problema: alguien tiene un paquete sin dueño.
  OVERAGE
  DAMAGED
  OVERWEIGHT
  CUSTOMS_HOLD
  DOCUMENTATION_REQUIRED
  ADDRESS_PROBLEM
  OTHER
}

enum ExceptionStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  /// Se asume la pérdida y se cierra. Es distinto de RESOLVED: uno se arregló,
  /// el otro se pagó. Mezclarlos hace imposible medir cuánto cuestan.
  WRITTEN_OFF
}

enum ExceptionSeverity {
  LOW
  MEDIUM
  HIGH
}

enum PackagePhotoType {
  /// La caja tal como llegó.
  EXTERIOR
  /// La etiqueta del transportista, que es de donde sale el tracking.
  LABEL
  /// El contenido, cuando el servicio contratado lo permite.
  CONTENT
  /// El daño concreto, para el reclamo.
  DAMAGE
}

/// Categoria aduanera del envio.
///
/// **Los nombres son los del procedimiento, los limites NO estan aqui.** Cual
/// aplica y hasta que valor lo dice `CustomsRule`, que se versiona por fechas
/// porque la normativa cambia. Meter «hasta 1000 dolares» en un enum lo
/// congelaria el dia que lo cambien, y peor: reescribiria el pasado, porque una
/// liquidacion de hace un anio dejaria de poder explicarse.
/// Por que concepto se cobra.
///
/// La lista es cerrada porque lo primero que se pregunta a fin de mes es cuanto
/// se facturo de flete y cuanto de manejo. Con el concepto en texto libre eso no
/// se puede sumar.
enum ChargeConcept {
  FREIGHT
  HANDLING
  FUEL
  INSURANCE
  STORAGE
  DELIVERY
  REPACK
  /// Arancel. Tributo: se cobra y se entrega al Estado.
  DUTY
  /// Impuesto sobre ventas. Tambien tributo.
  TAX
  PERMIT
  OTHER
}

/// De quien es el dinero.
///
/// **Esta es la distincion que la fase 4 viene a arreglar.** Hoy `CustomsRecord`
/// mezcla arancel, impuesto y cargo por manejo en la misma fila, y con eso no se
/// puede responder cuanto de lo cobrado es ingreso propio y cuanto es tributo
/// que solo se esta trasladando. Son cosas distintas contablemente: una va al
/// estado de resultados, la otra es una deuda con el Estado desde el momento en
/// que se cobra.
enum ChargeKind {
  /// Ingreso de la empresa.
  REVENUE
  /// Se cobra al cliente y se entrega a un tercero. No es ingreso.
  PASS_THROUGH
}

enum ChargeStatus {
  PENDING
  PAID
  /// Anulado. No se borra: un cargo que existio y se anulo es informacion.
  VOID
}

enum CustomsCategory {
  /// Correspondencia y documentos.
  A
  /// Mercancia comercial bajo el tramite simplificado.
  B
  /// Fuera del tramite simplificado: pasa por el general.
  C
  /// Pequenio envio familiar sin caracter comercial.
  ENVIO_FAMILIAR
}

/// Que papel hace un documento en el expediente.
enum DocumentType {
  COMMERCIAL_INVOICE
  AIR_WAYBILL
  CUSTOMS_DECLARATION
  PERMIT
  IDENTIFICATION
  OTHER
}

/// De donde salio el valor declarado.
///
/// Importa para saber de quien es la responsabilidad: en el tramite
/// simplificado el courier declara y responde por lo declarado, asi que no es lo
/// mismo un valor que puso el cliente en su prealerta que uno que leyo un
/// operador de una factura.
enum ValueSource {
  /// Lo dijo el cliente al prealertar.
  CUSTOMER
  /// Lo leyo un operador de la factura de compra.
  INVOICE
  /// Lo estimo la empresa por falta de documento.
  ESTIMATED
  /// Lo fijo la aduana tras revisar.
  CUSTOMS
}

enum CustomsStatus {
  PENDING
  IN_REVIEW
  ON_HOLD
  CLEARED
  REJECTED
}

enum VehicleType {
  MOTORCYCLE
  CAR
  VAN
  TRUCK
  BICYCLE
}

enum DriverStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum RouteStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StopType {
  PICKUP
  DELIVERY
}

enum StopStatus {
  PENDING
  ARRIVED
  COMPLETED
  FAILED
}

/// Como acabo un intento de entrega. Solo dos valores porque solo hay dos
/// desenlaces: se entrego o no se entrego. El matiz de POR QUE no se entrego
/// vive en `DeliveryFailureReason`, no aqui.
enum DeliveryOutcome {
  SUCCESS
  FAILED
}

/// Por que no se pudo entregar.
///
/// Hasta la fase 5 esto era texto libre (`ProofOfDelivery.failureReason`), y el
/// texto libre no se puede contar: «no estaba», «ausente», «nadie en casa» y
/// «Ausente!!» son la misma causa escrita de cuatro formas, asi que la pregunta
/// de fin de mes —cuantas entregas fallan por direccion mala y cuantas porque
/// el cliente no esta— no tenia respuesta.
///
/// Los seis primeros son los del plan (§5.1). `OTHER` existe a proposito: sin
/// una salida, el repartidor que se encuentra algo que no esta en la lista
/// elige el valor mas parecido y contamina justo la cifra que esto viene a
/// arreglar. Un `OTHER` con su nota se puede revisar y, si se repite, asciende
/// a valor propio.
enum DeliveryFailureReason {
  /// No habia quien recibiera.
  NO_RECIPIENT
  /// La direccion no corresponde o no existe.
  WRONG_ADDRESS
  /// El telefono del destinatario no contesta o esta apagado.
  PHONE_UNREACHABLE
  /// El destinatario rechaza el paquete.
  CUSTOMER_REFUSED
  /// Local cerrado en el horario de reparto.
  BUSINESS_CLOSED
  /// El cliente pide entregarlo otro dia.
  RESCHEDULED
  /// Cualquier otra cosa. Exige nota, ver `DeliveryAttempt.notes`.
  OTHER
}

enum PaymentType {
  COD
  SUBSCRIPTION
  /// Cobro de los cargos de un envio (flete, manejo, arancel, impuesto...).
  ///
  /// Un solo pago salda VARIOS cargos, que es como ocurre en el mostrador: el
  /// cliente paga el total, no una linea por concepto.
  CHARGES
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum PaymentStatus {
  PENDING
  COLLECTED
  REMITTED
  CANCELLED
}

enum WebhookStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum NotificationChannel {
  SMS
  EMAIL
  PUSH
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// Operador de la PLATAFORMA, no de una empresa.
///
/// Vive en su propia tabla y no en `User` a propósito: la identidad de tenant y
/// la de plataforma no deben compartir almacén. Con una bandera en `User`, una
/// cuenta OWNER comprometida quedaría a una columna de ver TODAS las empresas.
/// Aquí no hay `tenantId` y por eso la tabla NO lleva política RLS: es la única
/// del esquema que se consulta fuera del contexto de un tenant.
model PlatformAdmin {
  id         String     @id @default(uuid()) @db.Uuid
  email      String     @unique
  name       String?
  /// Id en ZITADEL. Las credenciales viven allí, igual que las de tenant.
  externalId String?    @unique @map("external_id")
  status     UserStatus @default(ACTIVE)
  lastLoginAt DateTime? @map("last_login_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("platform_admins")
}

/// Registro de todo lo que hace un superadmin.
///
/// Va aparte de `AuditLog`, que es tenant-scoped y vive bajo RLS: estas acciones
/// cruzan empresas y no pertenecen a ninguna, así que no se pueden guardar allí
/// sin romper el aislamiento.
///
/// **Todo lo relevante se copia, no se referencia.** El correo del actor y el
/// nombre de la empresa se guardan como texto y no como clave foránea: si se
/// borra una empresa o se retira a un administrador, el registro tiene que
/// seguir contando qué pasó. Un historial que se vacía cuando desaparece el
/// implicado es inútil justo el día que hace falta.
model PlatformAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  /// Id del admin, solo informativo: puede quedar apuntando a nada.
  adminId     String?  @map("admin_id") @db.Uuid
  /// Copia del correo del actor. Esto es lo que se lee en el panel.
  adminEmail  String   @map("admin_email")
  action      String
  /// Qué se tocó: "tenant" o "platform_admin".
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  /// Copia legible del objetivo (slug de la empresa, correo del admin).
  targetLabel String?  @map("target_label")
  /// Valor anterior y nuevo, para que "cambió el plan" diga de qué a qué.
  before      Json?
  after       Json?
  reason      String?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

/// Módulos del panel que se pueden activar o desactivar por empresa.
/// Los valores coinciden con las secciones de navegación del panel.
enum TenantModule {
  SHIPMENTS
  ROUTES
  DRIVERS
  INTAKE
  LOCKERS
  CARRIERS
  CUSTOMERS
  PRICING
  PAYMENTS
  BILLING
  NOTIFICATIONS
  AUDIT
  INTEGRATIONS
  CUSTOMS
  /// Manifiestos de carga y viajes. Es el nivel por encima de la consolidación:
  /// agrupar los bultos de todos los clientes en el vuelo del martes.
  MANIFESTS
  /// Excepciones: faltantes, sobrantes, daños, retenciones.
  EXCEPTIONS
  /// Posventa: reclamos, devoluciones y reembolsos. Módulo propio y no dentro
  /// de EXCEPTIONS porque son bandejas de dueños distintos —una la trabaja la
  /// bodega y la otra atención al cliente—, y una empresa pequeña puede querer
  /// la primera sin la segunda.
  AFTERSALES
}

/// Excepción al conjunto de módulos que trae el plan.
///
/// Solo se guarda lo que se DESVÍA del plan: así, al subir de plan, el tenant
/// hereda lo nuevo sin tener que reescribir sus filas. Lo escribe el superadmin,
/// lo lee el propio tenant, y por eso lleva RLS como cualquier tabla suya.
model TenantModuleOverride {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  module    TenantModule
  enabled   Boolean
  /// Por qué se hizo la excepción. Sin esto, meses después nadie recuerda si
  /// fue un acuerdo comercial o un apaño temporal.
  reason    String?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module])
  @@index([tenantId])
  @@map("tenant_module_overrides")
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  /// Teléfono o WhatsApp de contacto. Se pide en el alta porque es por donde se
  /// cierra la activación de un plan de prueba, y una cuenta con plan pedido y
  /// sin forma de contactar es una venta perdida por falta de un campo.
  phone     String?
  plan      Plan         @default(FREE)

  /// --- Datos fiscales -------------------------------------------------------
  /// NO se piden en el alta a propósito: no hacen falta para que la cuenta
  /// funcione, y cada campo en un registro cuesta conversión. Se exigen cuando
  /// de verdad hacen falta —al activar un plan de pago—, que es el mismo patrón
  /// de «no liberar de aduana con saldo pendiente».
  ///
  /// Esto es lo que Ruteo necesita para facturar A LA EMPRESA. Lo que la empresa
  /// necesita para facturar A SUS CLIENTES es otra cosa —en Honduras, CAI, rango
  /// de correlativos y fecha límite de emisión— y no cabe aquí: caduca y hay que
  /// renovarlo, así que necesita su propia pantalla con avisos.
  legalName      String? @map("legal_name")
  /// RTN en Honduras. Se guarda solo con dígitos, sin guiones ni espacios.
  taxId          String? @map("tax_id")
  billingEmail   String? @map("billing_email")
  billingAddress String? @map("billing_address")

  /// Divisor del peso volumétrico: `largo × ancho × alto (cm) / divisor`.
  ///
  /// Configurable y no constante en el código porque cambia por courier y por
  /// acuerdo comercial: 5000 es lo habitual en carga aérea, 6000 lo usan
  /// algunos couriers, y un cliente grande negocia el suyo. Con el valor en el
  /// código, cada acuerdo obligaría a un despliegue.
  volumetricDivisor Int @default(5000) @map("volumetric_divisor")
  status    TenantStatus @default(ACTIVE)
  /// Por qué se suspendió y desde cuándo. El estado sin motivo obliga a
  /// preguntar por WhatsApp qué pasó con una empresa.
  statusReason String?   @map("status_reason")
  statusAt     DateTime? @map("status_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  users          User[]
  customers      Customer[]
  customerAddresses CustomerAddress[]
  shipments      Shipment[]
  carriers       Carrier[]
  lockers        Locker[]
  lockerPackages LockerPackage[]
  customsRecords CustomsRecord[]
  zones          Zone[]
  rates          Rate[]
  drivers        Driver[]
  routes         Route[]
  routeStops     RouteStop[]
  pods           ProofOfDelivery[]
  deliveryAttempts DeliveryAttempt[]
  payments       Payment[]
  apiKeys        ApiKey[]
  webhooks       WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  files             FileObject[]
  packagePhotos     PackagePhoto[]
  warehouses        Warehouse[]
  trips             Trip[]
  manifests         Manifest[]
  manifestItems     ManifestItem[]
  exceptions        Exception[]
  customsRules      CustomsRule[]
  documents         Document[]
  charges           Charge[]
  subscription   Subscription?
  notifications  Notification[]
  auditLogs      AuditLog[]
  idempotencyKeys IdempotencyKey[]
  credentialTokens CredentialToken[]
  moduleOverrides  TenantModuleOverride[]
  claims           Claim[]
  claimFiles       ClaimFile[]
  exceptionFiles   ExceptionFile[]
  returns          Return[]
  refunds          Refund[]

  @@map("tenants")
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  email            String
  name             String?
  // Id del usuario en ZITADEL, que es donde viven las credenciales. Nulo solo
  // en filas sembradas por pruebas que no pasan por el alta real.
  // `refreshTokenHash` NO desaparece: el token de sesión lo sigue emitiendo
  // Ruteo, y ese hash es suyo, no una contraseña.
  externalId       String?    @unique @map("external_id")
  /// Espejo del estado en ZITADEL, para no consultarlo en cada carga del panel.
  /// La fuente de verdad sigue siendo ZITADEL; esto es caché.
  emailVerified    Boolean    @default(false) @map("email_verified")
  role             Role       @default(OPERATOR)
  status           UserStatus @default(ACTIVE)
  /// Foto de perfil. Apunta al `FileObject`, no a una URL: las URLs de este
  /// sistema se firman al leer y caducan en minutos, así que guardar una aquí
  /// sería guardar un pase muerto. `SetNull` porque quedarse sin foto no puede
  /// llevarse por delante al usuario.
  avatarFileId     String?    @map("avatar_file_id") @db.Uuid
  refreshTokenHash String?    @map("refresh_token_hash")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  avatar   FileObject? @relation("AvatarDeUsuario", fields: [avatarFileId], references: [id], onDelete: SetNull)
  driver   Driver?
  customer Customer?
  credentialTokens CredentialToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// Códigos de un solo uso para restablecer contraseña y verificar correo.
///
/// Los custodia RUTEO y no ZITADEL, y no es por gusto: comprobado el 2026-08-08,
/// llamando con el token de la cuenta de servicio ZITADEL **no valida**
/// `verification.verificationCode` —se le puede fijar la contraseña a cualquier
/// usuario con un código inventado, sin haber pedido restablecimiento—. Reenviar
/// el código que teclea el usuario habría dejado que cualquiera restableciera la
/// contraseña de cualquiera.
model CredentialToken {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  type      CredentialTokenType
  /// Solo el hash: si se filtra la tabla, los códigos no son utilizables.
  codeHash  String              @map("code_hash")
  expiresAt DateTime            @map("expires_at")
  usedAt    DateTime?           @map("used_at")
  /// Intentos fallidos contra este código. Un código de 6 dígitos son un millón
  /// de combinaciones: con 30 minutos de vigencia y sin tope, se fuerza.
  attempts  Int                 @default(0)
  createdAt DateTime            @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, type])
  @@map("credential_tokens")
}

enum CredentialTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  /// Alta de un miembro del equipo: el invitado elige su propia contraseña.
  INVITATION
}

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @unique @map("user_id") @db.Uuid
  name       String
  email      String?
  phone      String?
  documentId String?  @map("document_id")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  lockers   Locker[]
  shipments Shipment[]
  addresses CustomerAddress[]
  claims    Claim[]

  @@index([tenantId])
  @@map("customers")
}

/// Una direccion del cliente, escrita una vez y reutilizada.
///
/// Hasta ahora cada envio repetia la direccion en `destinationLabel` como texto
/// plano, asi que una colonia mal escrita habia que corregirla envio por envio
/// —o no se corregia, que es lo que pasa— y no habia forma de saber que dos
/// envios iban al mismo sitio.
///
/// **Los campos son los de Honduras y no un `address_line` generico.**
/// Departamento, municipio y colonia es como se dicen aqui las direcciones, y
/// son lo que un repartidor usa para ordenar su ruta. Metidos en una sola linea
/// de texto no se puede agrupar por zona ni contar cuanto se entrega en cada
/// municipio, que es la mitad de para que sirve tener la direccion aparte.
model CustomerAddress {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid

  /// Como la llama el cliente: «Casa», «Oficina», «Bodega del negocio».
  label String

  /// Quien recibe en ESTA direccion, cuando no es el cliente. La oficina la
  /// recibe recepcion y la casa la suegra; sin esto, el repartidor pregunta por
  /// el titular y le dicen que ahi no vive.
  recipientName  String? @map("recipient_name")
  recipientPhone String? @map("recipient_phone")

  department   String
  municipality String
  neighborhood String?
  street       String?

  /// «Porton negro frente a la pulperia La Bendicion». En media Honduras esto
  /// es lo unico que lleva al repartidor a la puerta, asi que es un campo
  /// propio y no una nota que se pierde.
  reference String?

  lat Float?
  lng Float?

  /// La que se propone al crear un envio. Una por cliente como mucho: lo impone
  /// un indice unico parcial que Prisma no sabe expresar, escrito a mano en la
  /// migracion.
  isDefault Boolean @default(false) @map("is_default")

  /// Archivar en vez de borrar. Una direccion la referencian envios ya
  /// entregados: borrarla dejaria el historial apuntando a nada, y con
  /// `SET NULL` se perderia la unica pista de que 40 envios fueron al mismo
  /// sitio. Archivada deja de ofrecerse y sigue explicando el pasado.
  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shipments Shipment[]

  @@index([tenantId])
  @@index([customerId, active])
  @@map("customer_addresses")
}

model Shipment {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  customerId     String?        @map("customer_id") @db.Uuid
  trackingNumber String         @unique @map("tracking_number")
  type           ShipmentType   @default(LOCAL)
  status         ShipmentStatus @default(CREATED)

  /// Como se entrega. Se elige al crear el envio y NO al descargar: es lo que
  /// decide en que monton va el bulto cuando llega, asi que saberlo despues de
  /// tenerlo en la mano es saberlo tarde.
  deliveryMode DeliveryMode @default(HOME) @map("delivery_mode")

  /// La sucursal donde lo retira el cliente. Obligatoria cuando el modo es
  /// BRANCH —lo exige el servicio—, nula en los demas: un envio a domicilio con
  /// sucursal asignada seria una contradiccion que despues nadie sabe leer.
  deliveryWarehouseId String? @map("delivery_warehouse_id") @db.Uuid

  recipientName  String  @map("recipient_name")
  recipientPhone String? @map("recipient_phone")

  /// La direccion reutilizable de la que salio este envio, si salio de una.
  ///
  /// Es una REFERENCIA, no la direccion: los campos planos de abajo siguen
  /// siendo la copia congelada del dia del envio. Corregir la colonia de un
  /// cliente en 2027 no puede reescribir a donde se entrego en 2026 —eso
  /// convertiria el historial en una version del presente— y a la vez hace
  /// falta poder decir «estos 40 envios fueron a esta direccion» para
  /// corregirla una vez. Mismo criterio que el peso cobrable congelado al
  /// recibir (fase 1) y las reglas de aduana versionadas (fase 3).
  destinationAddressId String? @map("destination_address_id") @db.Uuid

  originLabel        String? @map("origin_label")
  originCountry      String? @map("origin_country")
  destinationLabel   String? @map("destination_label")
  destinationCountry String? @map("destination_country")
  destinationLat     Float?  @map("destination_lat")
  destinationLng     Float?  @map("destination_lng")

  weightKg      Decimal? @map("weight_kg") @db.Decimal(10, 3)
  declaredValue Decimal? @map("declared_value") @db.Decimal(12, 2)
  codAmount     Decimal? @map("cod_amount") @db.Decimal(12, 2)
  currency      String   @default("USD")

  carrierTrackingNumber String? @map("carrier_tracking_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  destinationAddress CustomerAddress? @relation(fields: [destinationAddressId], references: [id], onDelete: SetNull)
  deliveryWarehouse  Warehouse?       @relation("EnvioSucursalDeEntrega", fields: [deliveryWarehouseId], references: [id], onDelete: SetNull)
  legs       ShipmentLeg[]
  events     ShipmentEvent[]
  packages   LockerPackage[]
  customs    CustomsRecord?
  routeStops RouteStop[]
  pods       ProofOfDelivery[]
  deliveryAttempts DeliveryAttempt[]
  payments   Payment[]
  notifications Notification[]
  manifestItems ManifestItem[]
  exceptions    Exception[]
  documents     Document[]
  charges       Charge[]
  claims        Claim[]
  devolucion    Return?

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([destinationAddressId])
  @@index([deliveryWarehouseId])
  /// La pregunta de la clasificación: qué hay pendiente de retirar y qué va a ruta.
  @@index([tenantId, deliveryMode])
  @@map("shipments")
}

model ShipmentLeg {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  shipmentId       String    @map("shipment_id") @db.Uuid
  sequence         Int
  mode             LegMode
  originLabel      String    @map("origin_label")
  destinationLabel String    @map("destination_label")
  originLat        Float?    @map("origin_lat")
  originLng        Float?    @map("origin_lng")
  destinationLat   Float?    @map("destination_lat")
  destinationLng   Float?    @map("destination_lng")
  status           LegStatus @default(PENDING)
  carrier          String?
  carrierId        String?   @map("carrier_id") @db.Uuid
  externalTracking String?   @map("external_tracking")
  etaAt            DateTime? @map("eta_at")
  departedAt       DateTime? @map("departed_at")
  arrivedAt        DateTime? @map("arrived_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  carrierRef  Carrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)

  @@unique([shipmentId, sequence])
  @@index([tenantId])
  @@index([shipmentId])
  @@index([carrierId])
  @@map("shipment_legs")
}

/// Lo que le ha pasado a un envio.
///
/// **El estado dice DONDE esta; el evento dice COMO llego ahi.** Son dos cosas
/// distintas y la fase 0.2 viene a separarlas: hasta ahora `status` era
/// obligatorio, asi que lo unico registrable era un cambio de estado y cualquier
/// otro hecho —«se verifico la factura», «se cobraron 135.63»— no tenia donde
/// caer. La alternativa era una maquina de treinta estados, y un estado no puede
/// representar «pesado» y «en aduana» a la vez, que es lo normal en la vida real.
model ShipmentEvent {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  shipmentId String            @map("shipment_id") @db.Uuid
  legId      String?           @map("leg_id") @db.Uuid
  /// Que paso. Obligatorio: es lo que da sentido a la fila.
  eventType  ShipmentEventType @map("event_type")
  /// Solo lo llevan los eventos que SI cambian el estado. El resto lo dejan nulo.
  status     ShipmentStatus?
  /// Quien puede verlo. INTERNAL por defecto porque lo contrario —que un hecho
  /// nuevo se publique al cliente salvo que alguien se acuerde de ocultarlo— se
  /// equivoca en la direccion cara.
  visibility EventVisibility   @default(INTERNAL)
  /// Cifras y referencias del hecho: importes, de/a, tipo de documento, ids.
  /// Json y no columnas porque cada tipo de evento acompaña datos distintos y
  /// una columna por tipo dejaria la tabla llena de nulos.
  metadata   Json?

  description     String?
  locationLabel   String?  @map("location_label")
  lat             Float?
  lng             Float?
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  occurredAt      DateTime @default(now()) @map("occurred_at")
  createdAt       DateTime @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([shipmentId, occurredAt])
  /// El rastreo publico pide siempre los eventos de un envio filtrando por
  /// visibilidad; es la consulta que ve mas trafico de todo el sistema porque no
  /// necesita sesion.
  @@index([shipmentId, visibility, occurredAt])
  @@map("shipment_events")
}

model Carrier {
  id                  String      @id @default(uuid()) @db.Uuid
  tenantId            String      @map("tenant_id") @db.Uuid
  name                String
  code                String
  type                CarrierType @default(COURIER)
  trackingUrlTemplate String?     @map("tracking_url_template")
  active              Boolean     @default(true)
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legs   ShipmentLeg[]
  trips  Trip[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("carriers")
}

model Locker {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  customerId    String?      @map("customer_id") @db.Uuid
  code          String
  customerName  String       @map("customer_name")
  customerEmail String?      @map("customer_email")
  customerPhone String?      @map("customer_phone")
  addressLine1  String       @map("address_line1")
  addressLine2  String?      @map("address_line2")
  city          String
  state         String
  postalCode    String       @map("postal_code")
  country       String       @default("US")
  status        LockerStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  packages LockerPackage[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([customerId])
  @@map("lockers")
}

model LockerPackage {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  lockerId         String        @map("locker_id") @db.Uuid
  shipmentId       String?       @map("shipment_id") @db.Uuid
  externalTracking String?       @map("external_tracking")
  merchant         String?
  description      String?
  weightKg         Decimal?      @map("weight_kg") @db.Decimal(10, 3)
  declaredValue    Decimal?      @map("declared_value") @db.Decimal(12, 2)
  currency         String        @default("USD")
  status           PackageStatus @default(PRE_ALERTED)
  preAlertedAt     DateTime      @default(now()) @map("pre_alerted_at")
  receivedAt       DateTime?     @map("received_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  /// --- Prealerta: lo que el cliente sabe antes de que el bulto exista -------
  /// Tienda y número de orden. Sin esto, un paquete que llega sin etiqueta
  /// legible no se puede casar con nada y acaba en el montón de «sin dueño».
  storeName        String?   @map("store_name")
  orderNumber      String?   @map("order_number")
  /// Cuándo dice el comercio que llega. Es lo que permite avisar de un paquete
  /// que se retrasó, en vez de esperar a que el cliente pregunte.
  estimatedArrival DateTime? @map("estimated_arrival")
  /// Qué es. Lo declara el cliente y lo confirma quien recibe; la fase 3 lo
  /// usará para decidir qué documentos exige la aduana.
  category         PackageCategory?
  /// Factura de compra. La aduana la pide y el cliente la tiene el día que
  /// compra, no el día que el paquete llega a la bodega.
  invoiceFileId    String?   @map("invoice_file_id") @db.Uuid

  /// --- Recepción: lo que la bodega mide -------------------------------------
  lengthCm Decimal? @map("length_cm") @db.Decimal(8, 2)
  widthCm  Decimal? @map("width_cm") @db.Decimal(8, 2)
  heightCm Decimal? @map("height_cm") @db.Decimal(8, 2)
  /// Los TRES pesos se conservan, y no es redundancia:
  ///   - `weightKg` (el real) es lo que cobra la aerolínea.
  ///   - `volumetricWeightKg` justifica el cobro ante el cliente que reclama
  ///     que su caja de almohadas pesa dos kilos.
  ///   - `chargeableWeightKg` es el máximo de los dos, CONGELADO al recibir:
  ///     recalcularlo después cambiaría facturas ya emitidas si alguien toca el
  ///     divisor volumétrico del tenant.
  volumetricWeightKg Decimal? @map("volumetric_weight_kg") @db.Decimal(10, 3)
  chargeableWeightKg Decimal? @map("chargeable_weight_kg") @db.Decimal(10, 3)
  /// Bultos dentro del mismo envío del comercio (una compra, tres cajas).
  pieces           Int              @default(1)
  condition        PackageCondition @default(GOOD)
  /// Quién lo recibió. Un daño que aparece después necesita saber quién lo tuvo
  /// delante, y sin esto la respuesta es «alguien de bodega».
  receivedByUserId String?          @map("received_by_user_id") @db.Uuid
  /// En qué bodega se recibió. Quedó pendiente en la fase 1 esperando a que
  /// `Warehouse` existiera: una columna nulable que nadie llena es
  /// indistinguible de un olvido.
  warehouseId      String?          @map("warehouse_id") @db.Uuid

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locker   Locker    @relation(fields: [lockerId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  invoice   FileObject? @relation("FacturaDePaquete", fields: [invoiceFileId], references: [id], onDelete: SetNull)
  warehouse Warehouse?  @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  photos    PackagePhoto[]
  exceptions Exception[]
  claims     Claim[]

  @@index([tenantId])
  @@index([lockerId])
  @@index([shipmentId])
  @@map("locker_packages")
}

/// Una bodega o sucursal física.
///
/// Antes «Miami» y «bodega HN» eran cadenas de texto dentro de `originLabel`.
/// Con una fila detrás se puede filtrar, contar, y —lo que hace falta para el
/// cotejo— decir contra qué bodega se está contando lo que llegó.
model Warehouse {
  id       String        @id @default(uuid()) @db.Uuid
  tenantId String        @map("tenant_id") @db.Uuid
  /// Corto y legible: MIA-01, SPS-01. Es lo que se dice por radio.
  code     String
  name     String
  type     WarehouseType @default(ORIGIN)
  country  String
  city     String?
  addressLine String?    @map("address_line")
  /// Si el cliente puede venir a retirar aquí. Lo necesita el modo de entrega
  /// de la fase 5, y se declara desde ya para no tener que migrar después.
  allowsPickup Boolean   @default(false) @map("allows_pickup")
  active    Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  packages LockerPackage[]
  tripsFrom Trip[]         @relation("BodegaOrigen")
  tripsTo   Trip[]         @relation("BodegaDestino")
  shipmentsForPickup Shipment[] @relation("EnvioSucursalDeEntrega")
  returns   Return[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

/// El vuelo (o el viaje) en el que se mueve la carga.
///
/// Va por encima del manifiesto y no dentro: un mismo vuelo puede llevar varios
/// manifiestos, y un manifiesto se prepara antes de saber en qué vuelo sale.
model Trip {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  carrierId    String?    @map("carrier_id") @db.Uuid
  /// Número de vuelo o de viaje. Es lo que se le dice a la aduana.
  flightNumber String?    @map("flight_number")
  originWarehouseId      String? @map("origin_warehouse_id") @db.Uuid
  destinationWarehouseId String? @map("destination_warehouse_id") @db.Uuid
  departureAt  DateTime?  @map("departure_at")
  arrivalAt    DateTime?  @map("arrival_at")
  status       TripStatus @default(PLANNED)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  carrier     Carrier?   @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  origin      Warehouse? @relation("BodegaOrigen", fields: [originWarehouseId], references: [id], onDelete: SetNull)
  destination Warehouse? @relation("BodegaDestino", fields: [destinationWarehouseId], references: [id], onDelete: SetNull)
  manifests   Manifest[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("trips")
}

/// El manifiesto de carga: la guía madre y el detalle de sus guías hijas.
///
/// Esto es lo que faltaba para que «consolidación» dejara de significar dos
/// cosas. Juntar tres paquetes de un cliente en un envío ya existía; agrupar
/// ciento cincuenta bultos de todos los clientes en el vuelo del martes es esto.
model Manifest {
  id       String         @id @default(uuid()) @db.Uuid
  tenantId String         @map("tenant_id") @db.Uuid
  /// El número que exige Aduanas. Único por empresa.
  number   String
  tripId   String?        @map("trip_id") @db.Uuid
  status   ManifestStatus @default(DRAFT)

  /// Totales DECLARADOS. Se calculan al cerrar el manifiesto, sumando sus
  /// líneas, y se congelan: son lo que se transmitió, y el cotejo compara
  /// contra ellos. Recalcularlos al leer haría que añadir una línea después
  /// cambiara retroactivamente lo que se declaró.
  totalPieces   Int     @default(0) @map("total_pieces")
  totalWeightKg Decimal @default(0) @map("total_weight_kg") @db.Decimal(12, 3)

  /// Totales CONTADOS al recibir. Nulos hasta que alguien cotea.
  receivedPieces   Int?     @map("received_pieces")
  receivedWeightKg Decimal? @map("received_weight_kg") @db.Decimal(12, 3)
  reconciledAt     DateTime? @map("reconciled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip       Trip?          @relation(fields: [tripId], references: [id], onDelete: SetNull)
  items      ManifestItem[]
  exceptions Exception[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("manifests")
}

/// Una guía hija dentro del manifiesto.
///
/// Los campos no son decorativos: número de guía, bultos, peso, descripción,
/// consignatario, flete y valor FOB son los que el procedimiento de courier pide
/// que se detallen. Se COPIAN del envío al añadir la línea en vez de leerse por
/// relación, porque el manifiesto es un documento: tiene que seguir diciendo lo
/// que decía el día que se transmitió, aunque el envío cambie después.
model ManifestItem {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  manifestId String @map("manifest_id") @db.Uuid
  shipmentId String @map("shipment_id") @db.Uuid

  pieces      Int      @default(1)
  weightKg    Decimal  @db.Decimal(10, 3)
  description String?
  consignee   String?
  freightAmount Decimal? @map("freight_amount") @db.Decimal(12, 2)
  fobValue      Decimal? @map("fob_value") @db.Decimal(12, 2)
  currency      String   @default("USD")

  /// Lo contado para ESTA línea. El cotejo por línea es lo que permite decir
  /// qué guía falta, en vez de solo que faltan tres bultos de ciento cincuenta.
  receivedPieces   Int?     @map("received_pieces")
  receivedWeightKg Decimal? @map("received_weight_kg") @db.Decimal(10, 3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manifest Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  /// Un envío no puede ir dos veces en el mismo manifiesto.
  @@unique([manifestId, shipmentId])
  @@index([tenantId])
  @@index([manifestId])
  @@map("manifest_items")
}

/// Algo que salió mal y hay que resolver.
///
/// **Es una entidad y no un estado, y ahí está todo el punto.** Un envío puede
/// estar a la vez «en aduana» y «con documentación pendiente»; con el problema
/// metido en `ShipmentStatus` habría que elegir cuál de las dos cosas contar, y
/// la operación real necesita las dos. Además cuelga de lo que sea —envío,
/// bulto o manifiesto—, y un estado solo puede vivir en una tabla.
model Exception {
  id       String            @id @default(uuid()) @db.Uuid
  tenantId String            @map("tenant_id") @db.Uuid
  type     ExceptionType
  status   ExceptionStatus   @default(OPEN)
  severity ExceptionSeverity @default(MEDIUM)

  /// A qué se refiere. Los tres son opcionales y al menos uno debería venir;
  /// no se fuerza en el esquema porque una excepción manual puede no colgar de
  /// nada todavía —«llegó un bulto sin etiqueta»—.
  shipmentId String? @map("shipment_id") @db.Uuid
  packageId  String? @map("package_id") @db.Uuid
  manifestId String? @map("manifest_id") @db.Uuid

  description String
  /// Qué se esperaba y qué había. Texto y no números: sirve igual para «100
  /// bultos / 1000 kg» que para «factura comercial», y una excepción que solo
  /// admitiera cifras no podría describir la mitad de los casos.
  expectedValue String? @map("expected_value")
  actualValue   String? @map("actual_value")

  assignedToUserId String?   @map("assigned_to_user_id") @db.Uuid
  createdByUserId  String?   @map("created_by_user_id") @db.Uuid
  resolution       String?
  resolvedAt       DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment Shipment?      @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  package  LockerPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  manifest Manifest?      @relation(fields: [manifestId], references: [id], onDelete: SetNull)
  files    ExceptionFile[]
  claims   Claim[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([shipmentId])
  @@map("exceptions")
}

/// Un cargo concreto de un envio.
///
/// **Sustituye a las columnas sueltas de `CustomsRecord`**, que mezclaban en una
/// misma fila el arancel (del Estado), el impuesto (del Estado) y el manejo (de
/// la empresa). Con todo junto no habia forma de separar ingreso de tributo
/// trasladado, y esa es justo la pregunta del cierre de mes.
///
/// `CustomsRecord` conserva sus columnas por compatibilidad —las leen las
/// pantallas y la API de hoy— pero la verdad contable esta aqui.
model Charge {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  shipmentId String        @map("shipment_id") @db.Uuid
  concept    ChargeConcept
  /// Ingreso propio o tributo trasladado. Se guarda y no se deduce del concepto
  /// porque un mismo concepto puede cambiar de naturaleza segun el acuerdo: hay
  /// couriers que absorben el manejo y otros que lo trasladan.
  kind       ChargeKind
  status     ChargeStatus  @default(PENDING)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("USD")

  /// De donde salio: `customs` si lo genero la liquidacion, `manual` si lo
  /// anadio alguien. Sirve para no duplicar al recalcular.
  source    String   @default("manual")
  notes     String?
  paidAt    DateTime? @map("paid_at")
  /// El pago que salda este cargo.
  ///
  /// Sin esto un cargo cobrado y un pago registrado eran dos hechos sueltos que
  /// nadie conciliaba: la caja cuadraba o no cuadraba y no habia forma de saber
  /// por que. La direccion es N cargos -> 1 pago porque el cliente paga el total
  /// de una vez.
  ///
  /// `SetNull` y no `Cascade`: si alguien borra el pago, el cargo sigue
  /// existiendo —se cobro de verdad— y lo que se pierde es el respaldo, no la
  /// deuda. Borrarlo dejaria un agujero en lo facturado.
  paymentId String?  @map("payment_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  payment  Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  claims   Claim[]

  @@index([tenantId])
  @@index([shipmentId])
  @@index([tenantId, status])
  @@index([paymentId])
  @@map("charges")
}

/// Un archivo subido al almacenamiento de objetos.
///
/// La prueba de entrega no necesitó esta tabla —tiene dos huecos fijos, firma y
/// foto, y dos columnas de clave bastaban—. Aquí sí hace falta: un bulto lleva
/// N fotos y no se sabe cuántas de antemano, así que la relación necesita filas.
///
/// **Es metadato, no el archivo.** El binario vive en MinIO bajo `key`. Esta
/// fila existe para poder listar, contar, atribuir y borrar sin recorrer el
/// bucket, y para que un reclamo pueda apoyarse en el tamaño y el tipo que se
/// registraron al subir.
model FileObject {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// Clave en el bucket. Única: dos filas apuntando al mismo objeto harían que
  /// borrar una dejara a la otra señalando a la nada.
  key          String   @unique
  contentType  String   @map("content_type")
  sizeBytes    Int      @map("size_bytes")
  /// Nombre con el que el usuario lo subió. Solo para mostrar: la ruta real es
  /// un UUID, precisamente para que este nombre no forme parte de ella.
  originalName String?  @map("original_name")
  uploadedByUserId String? @map("uploaded_by_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  packagePhotos PackagePhoto[]
  facturaDe     LockerPackage[] @relation("FacturaDePaquete")
  documents     Document[]
  claimFiles    ClaimFile[]
  exceptionFiles ExceptionFile[]
  avatarDe      User[]          @relation("AvatarDeUsuario")

  @@index([tenantId])
  @@map("file_objects")
}

/// Foto de un bulto en la recepción.
///
/// Es lo que convierte «llegó dañado» en una discusión con datos. Sin foto al
/// recibir, un daño reclamado tres días después no se puede atribuir a nadie: ni
/// al transportista, ni a la bodega, ni al cliente.
model PackagePhoto {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  packageId String            @map("package_id") @db.Uuid
  fileId    String            @map("file_id") @db.Uuid
  type      PackagePhotoType  @default(EXTERIOR)
  createdAt DateTime          @default(now()) @map("created_at")

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package LockerPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  file    FileObject    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([packageId])
  @@map("package_photos")
}

model CustomsRecord {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  shipmentId    String        @unique @map("shipment_id") @db.Uuid
  status        CustomsStatus @default(PENDING)

  /// Categoria bajo la que se despacha, y la regla que se le aplico.
  ///
  /// `ruleId` se guarda —no solo la categoria— porque es lo que permite explicar
  /// una liquidacion vieja: la regla pudo cambiar despues, y sin este puntero la
  /// respuesta a «por que se cobro esto» seria la tarifa de hoy.
  category      CustomsCategory?
  ruleId        String?         @map("rule_id") @db.Uuid

  /// --- Valor declarado, desglosado -----------------------------------------
  /// Valor de compra != valor aduanero. El aduanero suma flete y seguro, y es
  /// sobre el que se liquida. Guardar solo el total haria imposible rehacer el
  /// calculo o discutirlo con el cliente.
  productValue    Decimal? @map("product_value") @db.Decimal(12, 2)
  freightAmount   Decimal? @map("freight_amount") @db.Decimal(12, 2)
  insuranceAmount Decimal? @map("insurance_amount") @db.Decimal(12, 2)
  otherCharges    Decimal? @map("other_charges") @db.Decimal(12, 2)
  /// El resultante, sobre el que se calculan arancel e impuesto.
  customsValue    Decimal? @map("customs_value") @db.Decimal(12, 2)
  valueSource     ValueSource? @map("value_source")
  /// Quien declaro y quien verifico. En el tramite simplificado el courier
  /// responde por lo declarado, asi que esto no es trazabilidad opcional.
  declaredByUserId String? @map("declared_by_user_id") @db.Uuid
  verifiedByUserId String? @map("verified_by_user_id") @db.Uuid

  declaredValue Decimal?      @map("declared_value") @db.Decimal(12, 2)
  dutyAmount    Decimal?      @map("duty_amount") @db.Decimal(12, 2)
  taxAmount     Decimal?      @map("tax_amount") @db.Decimal(12, 2)
  handlingFee   Decimal?      @map("handling_fee") @db.Decimal(12, 2)
  totalCharges  Decimal?      @map("total_charges") @db.Decimal(12, 2)
  currency      String        @default("USD")
  notes         String?
  clearedAt     DateTime?     @map("cleared_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  rule     CustomsRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("customs_records")
}

/// Regla aduanera vigente durante un periodo.
///
/// **Versionada por fechas, y eso es el punto entero.** Cuando alguien pregunte
/// dentro de un anio por que se cobro lo que se cobro, la respuesta tiene que
/// salir de la regla que estaba vigente ESE dia, no de la de hoy. Por eso una
/// regla no se edita cuando cambia la normativa: se cierra con `effectiveTo` y
/// se crea la siguiente.
///
/// Los limites no estan en el codigo —ni siquiera como valor por defecto—
/// porque acabarian siendo la regla que nadie recuerda que existe.
model CustomsRule {
  id       String          @id @default(uuid()) @db.Uuid
  tenantId String          @map("tenant_id") @db.Uuid
  country  String
  category CustomsCategory

  /// Tope de valor aduanero para que esta categoria aplique. Nulo = sin tope.
  maxValue Decimal? @map("max_value") @db.Decimal(12, 2)
  currency String   @default("USD")

  requiresInvoice Boolean @default(false) @map("requires_invoice")
  requiresPermit  Boolean @default(false) @map("requires_permit")
  /// Si exige agente aduanero. Fuera del tramite simplificado suele exigirse.
  requiresBroker  Boolean @default(false) @map("requires_broker")

  /// Tasas como fraccion: 0.15 es el 15 %.
  dutyRate Decimal @default(0) @map("duty_rate") @db.Decimal(6, 4)
  taxRate  Decimal @default(0) @map("tax_rate") @db.Decimal(6, 4)

  effectiveFrom DateTime  @map("effective_from")
  /// Nulo = sigue vigente. Cerrar una regla es ponerle fecha, no borrarla.
  effectiveTo   DateTime? @map("effective_to")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records CustomsRecord[]

  @@index([tenantId])
  @@index([tenantId, country, category, effectiveFrom])
  @@map("customs_rules")
}

/// Un documento del expediente de un envio.
///
/// El archivo vive en el almacenamiento y aqui esta el metadato de QUE es y que
/// papel hace. `verifiedByUserId` separa «alguien subio un PDF» de «alguien lo
/// miro y dice que sirve», que es la diferencia entre tener un documento y
/// tener el tramite cubierto.
model Document {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  shipmentId String       @map("shipment_id") @db.Uuid
  fileId     String       @map("file_id") @db.Uuid
  type       DocumentType
  notes      String?

  uploadedByUserId String?   @map("uploaded_by_user_id") @db.Uuid
  verifiedByUserId String?   @map("verified_by_user_id") @db.Uuid
  verifiedAt       DateTime? @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  file     FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([shipmentId])
  @@map("documents")
}

model Zone {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  code        String
  description String?
  centerLat   Float?   @map("center_lat")
  centerLng   Float?   @map("center_lng")
  radiusKm    Float?   @map("radius_km")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rates   Rate[]
  drivers Driver[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("zones")
}

model Rate {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  zoneId    String?  @map("zone_id") @db.Uuid
  name      String
  baseFee   Decimal  @default(0) @map("base_fee") @db.Decimal(12, 2)
  perKg     Decimal  @default(0) @map("per_kg") @db.Decimal(12, 2)
  perKm     Decimal  @default(0) @map("per_km") @db.Decimal(12, 2)
  minCharge Decimal  @default(0) @map("min_charge") @db.Decimal(12, 2)
  currency  String   @default("HNL")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zone   Zone?  @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([zoneId])
  @@map("rates")
}

model Driver {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  userId       String?      @unique @map("user_id") @db.Uuid
  zoneId       String?      @map("zone_id") @db.Uuid
  name         String
  phone        String?
  vehicleType  VehicleType  @default(MOTORCYCLE) @map("vehicle_type")
  vehiclePlate String?      @map("vehicle_plate")
  status       DriverStatus @default(OFFLINE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  zone     Zone?     @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  routes   Route[]
  payments Payment[]

  @@index([tenantId])
  @@index([zoneId])
  @@map("drivers")
}

model Route {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  driverId      String      @map("driver_id") @db.Uuid
  code          String
  status        RouteStatus @default(PLANNED)
  scheduledDate DateTime    @map("scheduled_date") @db.Date
  startedAt     DateTime?   @map("started_at")
  completedAt   DateTime?   @map("completed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driver Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  stops  RouteStop[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([driverId])
  @@map("routes")
}

model RouteStop {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  routeId      String     @map("route_id") @db.Uuid
  shipmentId   String     @map("shipment_id") @db.Uuid
  sequence     Int
  type         StopType   @default(DELIVERY)
  status       StopStatus @default(PENDING)
  addressLabel String?    @map("address_label")
  lat          Float?
  lng          Float?
  notes        String?
  arrivedAt    DateTime?  @map("arrived_at")
  completedAt  DateTime?  @map("completed_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route    Route            @relation(fields: [routeId], references: [id], onDelete: Cascade)
  shipment Shipment         @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  pod      ProofOfDelivery?
  attempts DeliveryAttempt[]

  @@unique([routeId, sequence])
  @@index([tenantId])
  @@index([routeId])
  @@index([shipmentId])
  @@map("route_stops")
}

model ProofOfDelivery {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  shipmentId    String    @map("shipment_id") @db.Uuid
  routeStopId   String?   @unique @map("route_stop_id") @db.Uuid
  receivedBy    String?   @map("received_by")
  /// Clave del objeto en el almacenamiento, NO una URL.
  ///
  /// Antes eran `signature_url`/`photo_url` y aceptaban cualquier URL que
  /// mandara quien llamaba: nadie las llenaba —no había forma de subir un
  /// archivo— y, de haberlas llenado, el panel habría renderizado un `<img>`
  /// apuntando a donde el cliente quisiera. Ahora se guarda la clave que
  /// devuelve la subida firmada y la URL se firma al leer, con vigencia corta.
  signatureKey  String?   @map("signature_key")
  photoKey      String?   @map("photo_key")
  failureReason String?   @map("failure_reason")
  lat           Float?
  lng           Float?
  capturedAt    DateTime  @default(now()) @map("captured_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment  Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  routeStop RouteStop? @relation(fields: [routeStopId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([shipmentId])
  @@map("proof_of_deliveries")
}

/// Un intento de entrega. Uno por visita, salga bien o salga mal.
///
/// **Por que existe.** `ProofOfDelivery` tiene `route_stop_id` UNICO, asi que la
/// parada solo podia guardar UN intento: el segundo hacia `upsert` y pisaba al
/// primero. Se perdia justo lo que hay que poder demostrar —que se fue tres
/// veces y tres veces no habia nadie— y el KPI que mide de verdad la operacion,
/// entregas al primer intento, era incalculable porque el primer intento ya no
/// estaba.
///
/// **Que NO se hizo, y por que.** No se borro `ProofOfDelivery` ni se le quito
/// su unico. Sigue escribiendose igual que antes, como proyeccion del ultimo
/// intento de la parada, porque lo leen el detalle de ruta, el de envio y el
/// panel; romperlos no era parte de esta fase. Mismo criterio que la fase 4 con
/// las columnas de `customs_records`: la tabla nueva manda, la vieja se queda
/// mientras tenga lectores, y se retira cuando no le quede ninguno. Si este
/// traspaso saliera mal, borrar las filas de `delivery_attempts` devuelve el
/// sistema a donde estaba.
model DeliveryAttempt {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  shipmentId String @map("shipment_id") @db.Uuid

  /// Nulo si la parada se borro: el intento ocurrio y su historia no se va con
  /// la planificacion. Mismo criterio que `ProofOfDelivery.routeStopId`.
  routeStopId String? @map("route_stop_id") @db.Uuid

  /// 1, 2, 3... por ENVIO, no por parada.
  ///
  /// Por parada siempre valdria 1 y el KPI naceria vacio: una parada se cierra
  /// una sola vez (`assertNotFinal`), asi que el reintento real no es volver a
  /// la misma parada, es una parada NUEVA en la ruta del dia siguiente para el
  /// mismo envio. Lo que la operacion cuenta —y lo que el cliente pregunta— es
  /// cuantas veces se fue a entregar ESE paquete, no cuantas veces se toco una
  /// fila de planificacion.
  ///
  /// Se calcula al insertar y no se recalcula al leer: contar filas al vuelo
  /// daria numeros distintos si alguna se anula, y el «tercer intento» que le
  /// dijimos al cliente dejaria de serlo.
  attemptNumber Int @map("attempt_number")

  outcome DeliveryOutcome

  /// Solo lo llevan los fallidos. Un intento con exito y motivo de fallo seria
  /// una contradiccion, y la migracion lo prohibe con un CHECK.
  failureReason DeliveryFailureReason? @map("failure_reason")

  /// El detalle a mano. Obligatorio cuando el motivo es OTHER —lo impone el
  /// servicio—, opcional en el resto: «dejo dicho que pasemos por la tarde».
  notes String?

  receivedBy String? @map("received_by")

  /// Claves del almacenamiento, NUNCA URLs. Ver `ProofOfDelivery`.
  signatureKey String? @map("signature_key")
  photoKey     String? @map("photo_key")

  lat Float?
  lng Float?

  /// Sin FK a `users`, igual que `ShipmentEvent.createdByUserId`: el intento es
  /// un hecho historico y borrar al repartidor no debe borrar ni mutilar la
  /// prueba de lo que hizo.
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  attemptedAt DateTime @default(now()) @map("attempted_at")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment  Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  routeStop RouteStop? @relation(fields: [routeStopId], references: [id], onDelete: SetNull)

  /// Dos intentos no pueden compartir numero en el mismo envio. Es lo que hace
  /// segura la asignacion del numero: dos repartidores cerrando a la vez chocan
  /// contra el indice en vez de crear dos «intento 2».
  @@unique([shipmentId, attemptNumber])
  @@index([tenantId])
  @@index([routeStopId])
  @@index([shipmentId, attemptedAt])
  /// El KPI de primer intento filtra por desenlace dentro de la empresa.
  @@index([tenantId, outcome])
  @@map("delivery_attempts")
}

model Payment {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  shipmentId          String?        @map("shipment_id") @db.Uuid
  type                PaymentType    @default(COD)
  amount              Decimal        @db.Decimal(12, 2)
  currency            String         @default("HNL")
  method              PaymentMethod?
  status              PaymentStatus  @default(PENDING)
  collectedByDriverId String?        @map("collected_by_driver_id") @db.Uuid
  reference           String?
  collectedAt         DateTime?      @map("collected_at")
  remittedAt          DateTime?      @map("remitted_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  driver   Driver?   @relation(fields: [collectedByDriverId], references: [id], onDelete: SetNull)
  charges  Charge[]
  refunds  Refund[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([shipmentId])
  @@map("payments")
}

/// Lo que una llave de API puede hacer. Es lo que separa «una llave» de «la
/// llave»: sin esto, la clave que la empresa entrega a quien le programó la web
/// sirve para todo lo que acepte `x-api-key`, y el día que se filtre se lleva
/// por delante mucho más de lo que hacía falta.
///
/// El catálogo es corto a propósito. Un alcance por endpoint es un permiso que
/// nadie configura bien; la unidad útil es «leer» y «escribir» por área.
enum ApiScope {
  SHIPMENTS_READ
  SHIPMENTS_WRITE
  LOCKERS_READ
  LOCKERS_WRITE
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  prefix     String    @unique
  keyHash    String    @map("key_hash")
  /// Sin alcances la llave no abre nada. El valor por defecto es la lista
  /// vacía, no «todo», para que una llave creada por un camino que todavía no
  /// los pide nazca inútil en vez de omnipotente.
  ///
  /// El `@default([])` está escrito aquí y no sólo en el SQL de la migración:
  /// sin él el modelo y la base discrepan, y el siguiente `migrate diff` genera
  /// un `DROP DEFAULT` que se lleva por delante justo esa garantía.
  scopes     ApiScope[] @default([])
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

model WebhookEndpoint {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  url       String
  secret    String
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  endpointId     String        @map("endpoint_id") @db.Uuid
  event          String
  payload        Json          @db.JsonB
  status         WebhookStatus @default(PENDING)
  attempts       Int           @default(0)
  responseStatus Int?          @map("response_status")
  lastError      String?       @map("last_error")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([endpointId])
  @@map("webhook_deliveries")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @unique @map("tenant_id") @db.Uuid
  plan               Plan
  status             SubscriptionStatus @default(ACTIVE)
  provider           String             @default("manual")
  providerRef        String?            @map("provider_ref")
  amount             Decimal            @db.Decimal(12, 2)
  currency           String             @default("HNL")
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime?          @map("canceled_at")
  /// Cuándo se avisó de que la prueba está por vencer. Es lo que impide que el
  /// aviso se repita en cada pasada del trabajo: sin esta marca, una prueba a
  /// tres días de vencer generaría un correo cada doce horas hasta que caduque.
  trialWarnedAt      DateTime?          @map("trial_warned_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  // Lo usa el barrido de `caducar_pruebas()`. Se declara aquí y no solo en la
  // migración que lo creó porque, si no, Prisma lo ve como deriva y la
  // siguiente `migrate dev` genera un DROP INDEX silencioso: el barrido pasaría
  // a recorrer la tabla entera sin que nadie se entere.
  @@index([status, currentPeriodEnd], map: "subscriptions_status_period_end_idx")
  @@map("subscriptions")
}

model Notification {
  id         String              @id @default(uuid()) @db.Uuid
  tenantId   String              @map("tenant_id") @db.Uuid
  shipmentId String?             @map("shipment_id") @db.Uuid
  channel    NotificationChannel
  recipient  String
  type       String
  title      String?
  body       String
  status     NotificationStatus  @default(PENDING)
  provider   String              @default("log")
  error      String?
  sentAt     DateTime?           @map("sent_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([shipmentId])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorRole   String?  @map("actor_role")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, action])
  @@map("audit_logs")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  key            String
  endpoint       String
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")
  /// Pasada esta fecha la clave deja de reproducirse y la purga se la lleva.
  expiresAt      DateTime @map("expires_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Fase 6 — Posventa
//
// Va al final del plan a propósito: un reclamo se resuelve con la evidencia que
// las fases anteriores dejaron —fotos de la recepción, intentos de entrega con
// motivo tipificado, cargos separados por naturaleza—. Sin eso, «se dañó»
// contra «llegó así» es la palabra de uno contra la del otro.
// ---------------------------------------------------------------------------

enum ClaimType {
  /// Llegó roto. La evidencia suele estar ya en las fotos de la recepción.
  DAMAGED
  /// No aparece. Distinto de MISSING_ITEM: aquí no hay bulto.
  LOST
  /// El bulto llegó pero le falta contenido.
  MISSING_ITEM
  /// Le cobraron de más, o algo que no correspondía.
  WRONG_CHARGE
  OTHER
}

/// El ciclo de un reclamo, que NO es el de una excepción.
///
/// Una excepción se resuelve arreglando algo; un reclamo se decide. Por eso hay
/// dos finales distintos con dinero de por medio (`APPROVED` -> `SETTLED`) y uno
/// sin él (`REJECTED`), en vez de un `RESOLVED` que no distingue quién tenía
/// razón. Sin esa separación no se puede responder cuánto cuesta la posventa.
enum ClaimStatus {
  OPEN
  INVESTIGATING
  /// Se le da la razón. Todavía no se ha pagado nada.
  APPROVED
  REJECTED
  /// Aprobado Y saldado: se emitió el reembolso.
  SETTLED
}

enum ReturnDestination {
  /// Se queda en una sucursal propia esperando a que lo retiren.
  BRANCH
  /// Vuelve a quien lo envió.
  SENDER
  /// Vuelve al comercio donde se compró. Es lo normal en compras de USA.
  VENDOR
  /// Nadie lo reclamó y se dispone de él. No es un fracaso administrativo: es
  /// una salida que hay que poder contar.
  ABANDONED
}

/// Por qué vuelve. Tipificado y no texto libre por lo mismo que los motivos de
/// entrega fallida de la fase 5: sin valores cerrados no se puede saber si lo
/// que devuelve la gente es un problema de direcciones o de precio.
enum ReturnReason {
  /// Se agotaron los intentos de entrega.
  UNDELIVERABLE
  /// El destinatario no lo quiso.
  REFUSED
  /// Nadie lo retiró de la sucursal en el plazo.
  UNCLAIMED
  /// No pagó los cargos, así que no se entrega.
  UNPAID
  /// Aduana no lo dejó entrar.
  CUSTOMS_REJECTED
  DAMAGED
  OTHER
}

enum ReturnStatus {
  /// Decidido pero el bulto sigue donde estaba.
  PENDING
  IN_TRANSIT
  /// Llegó a su destino: entregado al remitente, en el estante de la sucursal
  /// o dispuesto si era abandono.
  COMPLETED
  /// Se decidió devolver y luego no: el cliente apareció y lo retiró.
  CANCELLED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

/// Reclamo del cliente. Entidad propia y no un tipo de `Exception` porque el
/// actor y el desenlace son otros: una excepción la abre la bodega y se cierra
/// arreglando algo; un reclamo lo abre el cliente y se cierra con dinero o con
/// un no razonado. Mezclarlos deja lo interno a un campo de ser visible fuera.
model Claim {
  id       String      @id @default(uuid()) @db.Uuid
  tenantId String      @map("tenant_id") @db.Uuid
  /// Código visible del reclamo (`REC-XXXXXX`), para poder decirlo por
  /// teléfono. Aleatorio y no correlativo, como el resto de códigos del
  /// sistema: un correlativo necesita una secuencia por empresa, y además le
  /// dice a cualquier cliente cuántos reclamos lleva el courier este mes.
  number   String
  type     ClaimType
  status   ClaimStatus @default(OPEN)

  shipmentId String  @map("shipment_id") @db.Uuid
  packageId  String? @map("package_id") @db.Uuid
  /// Quién reclama. Opcional porque un reclamo puede entrar por teléfono antes
  /// de saber a qué ficha corresponde.
  customerId String? @map("customer_id") @db.Uuid
  /// De qué excepción salió, si salió de una. Es el puente entre la bandeja
  /// interna y la del cliente: la bodega detecta el daño, el cliente reclama.
  exceptionId String? @map("exception_id") @db.Uuid
  /// El cargo que se discute. Solo tiene sentido en WRONG_CHARGE.
  chargeId    String? @map("charge_id") @db.Uuid

  description String
  /// Lo que pide. Puede no pedir cifra —«que me digan dónde está»—.
  claimedAmount  Decimal? @map("claimed_amount") @db.Decimal(12, 2)
  /// Lo que se le concede. Se guarda aparte de lo reclamado a propósito: la
  /// diferencia entre ambos es la única forma de saber si la política de
  /// posventa está calibrada o si se regatea caso por caso.
  approvedAmount Decimal? @map("approved_amount") @db.Decimal(12, 2)
  currency       String   @default("USD")

  openedByUserId   String?   @map("opened_by_user_id") @db.Uuid
  assignedToUserId String?   @map("assigned_to_user_id") @db.Uuid
  resolvedByUserId String?   @map("resolved_by_user_id") @db.Uuid
  /// Por qué se decidió lo que se decidió. Obligatorio al cerrar, lo comprueba
  /// el servicio: un rechazo sin motivo escrito es el que vuelve por teléfono.
  resolution       String?
  resolvedAt       DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment  Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  package   LockerPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  customer  Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  exception Exception?     @relation(fields: [exceptionId], references: [id], onDelete: SetNull)
  charge    Charge?        @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  files     ClaimFile[]
  refunds   Refund[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([shipmentId])
  @@index([customerId])
  @@map("claims")
}

/// Evidencia del reclamo. Tabla puente y no una columna de archivo porque un
/// reclamo llega con varias fotos, y con una sola columna la segunda obliga a
/// elegir cuál se conserva.
model ClaimFile {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  claimId      String   @map("claim_id") @db.Uuid
  fileId       String   @map("file_id") @db.Uuid
  /// Quién la aportó: el cliente que reclama o la empresa que se defiende. La
  /// misma foto significa lo contrario según quién la trajo.
  fromCustomer Boolean  @default(false) @map("from_customer")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  claim  Claim      @relation(fields: [claimId], references: [id], onDelete: Cascade)
  file   FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([claimId])
  @@map("claim_files")
}

/// Evidencia de una excepción. Lo dejó pendiente la fase 2 —«el cotejo no tiene
/// evidencia adjunta»— y su sitio es aquí porque es lo mismo que necesita un
/// reclamo: sin la foto del bulto roto, la diferencia del cotejo es una cifra
/// que nadie puede discutir después.
model ExceptionFile {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  exceptionId String   @map("exception_id") @db.Uuid
  fileId      String   @map("file_id") @db.Uuid
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exception Exception  @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  file      FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([exceptionId])
  @@map("exception_files")
}

/// Devolución. Cuelga del envío original y no crea uno inverso: «abandonado» y
/// «a sucursal» no son una entrega, así que un envío nuevo quedaría vacío en la
/// mitad de los destinos, y el cliente perdería el número con el que ya venía
/// rastreando.
///
/// Una por envío (`@unique`): un bulto vuelve una vez. Si vuelve a salir y a
/// volver, es la misma devolución reabierta y no dos.
model Return {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  shipmentId  String            @unique @map("shipment_id") @db.Uuid
  destination ReturnDestination
  reason      ReturnReason
  status      ReturnStatus      @default(PENDING)

  /// A qué sucursal vuelve. Solo con destino BRANCH; el servicio lo exige.
  warehouseId String? @map("warehouse_id") @db.Uuid

  notes String?
  /// Cuántos intentos de entrega hubo antes de rendirse. Se copia al crear la
  /// devolución en vez de contarse al leer: es la cifra que justifica la
  /// decisión, y contarla después la haría cambiar con los datos.
  attemptsBefore Int? @map("attempts_before")

  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid
  completedAt     DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment  Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("returns")
}

/// Devolver dinero YA COBRADO. Lo dejó pendiente la fase 4, que lo separó de
/// anular: `ChargeStatus.VOID` cubre el cargo que nunca debió emitirse —no hubo
/// movimiento de caja— y esto cubre el que se cobró bien y hay que devolver.
///
/// Entidad propia y no un `Payment` de importe negativo: los negativos se
/// cuelan en todas las sumas de analítica y convierten «cuánto se cobró» en
/// «cuánto se cobró neto» sin que nadie lo haya pedido. Aquí el dinero que
/// entra y el que sale son dos tablas, y cada pregunta tiene su respuesta.
model Refund {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  /// El pago que se devuelve, entero o en parte.
  paymentId String       @map("payment_id") @db.Uuid
  /// El reclamo que lo motivó, si lo hubo: un reembolso también puede salir de
  /// una devolución sin reclamo de por medio.
  claimId   String?      @map("claim_id") @db.Uuid
  status    RefundStatus @default(PENDING)

  amount    Decimal        @db.Decimal(12, 2)
  currency  String         @default("HNL")
  method    PaymentMethod?
  reason    String
  reference String?

  issuedByUserId String?   @map("issued_by_user_id") @db.Uuid
  completedAt    DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  claim   Claim?  @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([paymentId])
  @@map("refunds")
}
