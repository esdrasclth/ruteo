generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum Role {
  OWNER
  ADMIN
  OPERATOR
  DRIVER
  MERCHANT
  SUPPORT
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ShipmentType {
  LOCAL
  INTERNATIONAL
}

enum ShipmentStatus {
  CREATED
  // local milestones
  LABEL_GENERATED
  PICKED_UP
  IN_TRANSIT
  // international milestones (USA -> HN)
  RECEIVED_USA
  CONSOLIDATED
  IN_TRANSIT_INTL
  IN_CUSTOMS_HN
  CUSTOMS_CLEARED
  IN_WAREHOUSE_HN
  // shared last mile
  OUT_FOR_DELIVERY
  DELIVERED
  // branches
  FAILED_ATTEMPT
  RETURNED
  CANCELLED
  ON_HOLD_CUSTOMS
}

enum LegMode {
  AIR
  SEA
  GROUND
}

enum LegStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum CarrierType {
  COURIER
  AIRLINE
  OCEAN
  GROUND
}

enum LockerStatus {
  ACTIVE
  SUSPENDED
}

enum PackageStatus {
  PRE_ALERTED
  RECEIVED
  CONSOLIDATED
  SHIPPED
}

/// En qué estado llegó el bulto a la bodega.
///
/// Se registra SIEMPRE, aunque sea `GOOD`: «no se anotó nada» y «se revisó y
/// estaba bien» son cosas distintas el día que alguien reclama, y sin un valor
/// por defecto explícito no hay forma de distinguirlas.
enum PackageCondition {
  GOOD
  DAMAGED
  WET
  OPENED
}

/// Qué hay dentro, a ojos de la operación.
///
/// **No es una clasificación arancelaria.** Es la que usa el operador para
/// decidir si algo necesita revisión y para que la fase 3 sepa qué documentos
/// pedir. Las partidas y los límites de aduana van en `CustomsRule`, que se
/// versiona por fechas porque la normativa cambia; esta lista no.
enum PackageCategory {
  ELECTRONICS
  CLOTHING
  FOOTWEAR
  HOME
  AUTO_PARTS
  COSMETICS
  MEDICINE
  DOCUMENTS
  OTHER
}

/// Qué papel juega una bodega en la operación.
enum WarehouseType {
  /// Donde se recibe del comercio: Miami, típicamente.
  ORIGIN
  /// Donde llega la carga y se desconsolida: la del país de destino.
  DESTINATION
  /// Sucursal donde el cliente puede retirar.
  BRANCH
}

/// Estado del viaje que transporta la carga.
enum TripStatus {
  PLANNED
  IN_TRANSIT
  ARRIVED
  CANCELLED
}

/// Estado del manifiesto.
///
/// `RECONCILED` es el que importa: significa que lo declarado se contó contra lo
/// que llegó de verdad. Sin ese paso, el manifiesto es una lista de intenciones.
enum ManifestStatus {
  DRAFT
  TRANSMITTED
  ARRIVED
  RECONCILED
}

/// Qué salió mal.
///
/// La lista es cerrada a propósito: una excepción con el motivo en texto libre
/// no se puede contar, y lo primero que se pregunta al final del mes es cuántos
/// faltantes hubo.
enum ExceptionType {
  /// Lo manifestado no cuadra con lo recibido. Ver `ManifestsService.cotejar`.
  MANIFEST_MISMATCH
  /// Llegaron menos bultos de los declarados.
  MISSING
  /// Llegaron más. También es un problema: alguien tiene un paquete sin dueño.
  OVERAGE
  DAMAGED
  OVERWEIGHT
  CUSTOMS_HOLD
  DOCUMENTATION_REQUIRED
  ADDRESS_PROBLEM
  OTHER
}

enum ExceptionStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  /// Se asume la pérdida y se cierra. Es distinto de RESOLVED: uno se arregló,
  /// el otro se pagó. Mezclarlos hace imposible medir cuánto cuestan.
  WRITTEN_OFF
}

enum ExceptionSeverity {
  LOW
  MEDIUM
  HIGH
}

enum PackagePhotoType {
  /// La caja tal como llegó.
  EXTERIOR
  /// La etiqueta del transportista, que es de donde sale el tracking.
  LABEL
  /// El contenido, cuando el servicio contratado lo permite.
  CONTENT
  /// El daño concreto, para el reclamo.
  DAMAGE
}

enum CustomsStatus {
  PENDING
  IN_REVIEW
  ON_HOLD
  CLEARED
  REJECTED
}

enum VehicleType {
  MOTORCYCLE
  CAR
  VAN
  TRUCK
  BICYCLE
}

enum DriverStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum RouteStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StopType {
  PICKUP
  DELIVERY
}

enum StopStatus {
  PENDING
  ARRIVED
  COMPLETED
  FAILED
}

enum PaymentType {
  COD
  SUBSCRIPTION
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum PaymentStatus {
  PENDING
  COLLECTED
  REMITTED
  CANCELLED
}

enum WebhookStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum NotificationChannel {
  SMS
  EMAIL
  PUSH
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// Operador de la PLATAFORMA, no de una empresa.
///
/// Vive en su propia tabla y no en `User` a propósito: la identidad de tenant y
/// la de plataforma no deben compartir almacén. Con una bandera en `User`, una
/// cuenta OWNER comprometida quedaría a una columna de ver TODAS las empresas.
/// Aquí no hay `tenantId` y por eso la tabla NO lleva política RLS: es la única
/// del esquema que se consulta fuera del contexto de un tenant.
model PlatformAdmin {
  id         String     @id @default(uuid()) @db.Uuid
  email      String     @unique
  name       String?
  /// Id en ZITADEL. Las credenciales viven allí, igual que las de tenant.
  externalId String?    @unique @map("external_id")
  status     UserStatus @default(ACTIVE)
  lastLoginAt DateTime? @map("last_login_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("platform_admins")
}

/// Registro de todo lo que hace un superadmin.
///
/// Va aparte de `AuditLog`, que es tenant-scoped y vive bajo RLS: estas acciones
/// cruzan empresas y no pertenecen a ninguna, así que no se pueden guardar allí
/// sin romper el aislamiento.
///
/// **Todo lo relevante se copia, no se referencia.** El correo del actor y el
/// nombre de la empresa se guardan como texto y no como clave foránea: si se
/// borra una empresa o se retira a un administrador, el registro tiene que
/// seguir contando qué pasó. Un historial que se vacía cuando desaparece el
/// implicado es inútil justo el día que hace falta.
model PlatformAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  /// Id del admin, solo informativo: puede quedar apuntando a nada.
  adminId     String?  @map("admin_id") @db.Uuid
  /// Copia del correo del actor. Esto es lo que se lee en el panel.
  adminEmail  String   @map("admin_email")
  action      String
  /// Qué se tocó: "tenant" o "platform_admin".
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  /// Copia legible del objetivo (slug de la empresa, correo del admin).
  targetLabel String?  @map("target_label")
  /// Valor anterior y nuevo, para que "cambió el plan" diga de qué a qué.
  before      Json?
  after       Json?
  reason      String?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

/// Módulos del panel que se pueden activar o desactivar por empresa.
/// Los valores coinciden con las secciones de navegación del panel.
enum TenantModule {
  SHIPMENTS
  ROUTES
  DRIVERS
  INTAKE
  LOCKERS
  CARRIERS
  CUSTOMERS
  PRICING
  PAYMENTS
  BILLING
  NOTIFICATIONS
  AUDIT
  INTEGRATIONS
  CUSTOMS
  /// Manifiestos de carga y viajes. Es el nivel por encima de la consolidación:
  /// agrupar los bultos de todos los clientes en el vuelo del martes.
  MANIFESTS
  /// Excepciones: faltantes, sobrantes, daños, retenciones.
  EXCEPTIONS
}

/// Excepción al conjunto de módulos que trae el plan.
///
/// Solo se guarda lo que se DESVÍA del plan: así, al subir de plan, el tenant
/// hereda lo nuevo sin tener que reescribir sus filas. Lo escribe el superadmin,
/// lo lee el propio tenant, y por eso lleva RLS como cualquier tabla suya.
model TenantModuleOverride {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  module    TenantModule
  enabled   Boolean
  /// Por qué se hizo la excepción. Sin esto, meses después nadie recuerda si
  /// fue un acuerdo comercial o un apaño temporal.
  reason    String?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module])
  @@index([tenantId])
  @@map("tenant_module_overrides")
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  /// Teléfono o WhatsApp de contacto. Se pide en el alta porque es por donde se
  /// cierra la activación de un plan de prueba, y una cuenta con plan pedido y
  /// sin forma de contactar es una venta perdida por falta de un campo.
  phone     String?
  plan      Plan         @default(FREE)

  /// --- Datos fiscales -------------------------------------------------------
  /// NO se piden en el alta a propósito: no hacen falta para que la cuenta
  /// funcione, y cada campo en un registro cuesta conversión. Se exigen cuando
  /// de verdad hacen falta —al activar un plan de pago—, que es el mismo patrón
  /// de «no liberar de aduana con saldo pendiente».
  ///
  /// Esto es lo que Ruteo necesita para facturar A LA EMPRESA. Lo que la empresa
  /// necesita para facturar A SUS CLIENTES es otra cosa —en Honduras, CAI, rango
  /// de correlativos y fecha límite de emisión— y no cabe aquí: caduca y hay que
  /// renovarlo, así que necesita su propia pantalla con avisos.
  legalName      String? @map("legal_name")
  /// RTN en Honduras. Se guarda solo con dígitos, sin guiones ni espacios.
  taxId          String? @map("tax_id")
  billingEmail   String? @map("billing_email")
  billingAddress String? @map("billing_address")

  /// Divisor del peso volumétrico: `largo × ancho × alto (cm) / divisor`.
  ///
  /// Configurable y no constante en el código porque cambia por courier y por
  /// acuerdo comercial: 5000 es lo habitual en carga aérea, 6000 lo usan
  /// algunos couriers, y un cliente grande negocia el suyo. Con el valor en el
  /// código, cada acuerdo obligaría a un despliegue.
  volumetricDivisor Int @default(5000) @map("volumetric_divisor")
  status    TenantStatus @default(ACTIVE)
  /// Por qué se suspendió y desde cuándo. El estado sin motivo obliga a
  /// preguntar por WhatsApp qué pasó con una empresa.
  statusReason String?   @map("status_reason")
  statusAt     DateTime? @map("status_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  users          User[]
  customers      Customer[]
  shipments      Shipment[]
  carriers       Carrier[]
  lockers        Locker[]
  lockerPackages LockerPackage[]
  customsRecords CustomsRecord[]
  zones          Zone[]
  rates          Rate[]
  drivers        Driver[]
  routes         Route[]
  routeStops     RouteStop[]
  pods           ProofOfDelivery[]
  payments       Payment[]
  apiKeys        ApiKey[]
  webhooks       WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  files             FileObject[]
  packagePhotos     PackagePhoto[]
  warehouses        Warehouse[]
  trips             Trip[]
  manifests         Manifest[]
  manifestItems     ManifestItem[]
  exceptions        Exception[]
  subscription   Subscription?
  notifications  Notification[]
  auditLogs      AuditLog[]
  idempotencyKeys IdempotencyKey[]
  credentialTokens CredentialToken[]
  moduleOverrides  TenantModuleOverride[]

  @@map("tenants")
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  email            String
  name             String?
  // Id del usuario en ZITADEL, que es donde viven las credenciales. Nulo solo
  // en filas sembradas por pruebas que no pasan por el alta real.
  // `refreshTokenHash` NO desaparece: el token de sesión lo sigue emitiendo
  // Ruteo, y ese hash es suyo, no una contraseña.
  externalId       String?    @unique @map("external_id")
  /// Espejo del estado en ZITADEL, para no consultarlo en cada carga del panel.
  /// La fuente de verdad sigue siendo ZITADEL; esto es caché.
  emailVerified    Boolean    @default(false) @map("email_verified")
  role             Role       @default(OPERATOR)
  status           UserStatus @default(ACTIVE)
  refreshTokenHash String?    @map("refresh_token_hash")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driver   Driver?
  customer Customer?
  credentialTokens CredentialToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// Códigos de un solo uso para restablecer contraseña y verificar correo.
///
/// Los custodia RUTEO y no ZITADEL, y no es por gusto: comprobado el 2026-08-08,
/// llamando con el token de la cuenta de servicio ZITADEL **no valida**
/// `verification.verificationCode` —se le puede fijar la contraseña a cualquier
/// usuario con un código inventado, sin haber pedido restablecimiento—. Reenviar
/// el código que teclea el usuario habría dejado que cualquiera restableciera la
/// contraseña de cualquiera.
model CredentialToken {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  type      CredentialTokenType
  /// Solo el hash: si se filtra la tabla, los códigos no son utilizables.
  codeHash  String              @map("code_hash")
  expiresAt DateTime            @map("expires_at")
  usedAt    DateTime?           @map("used_at")
  /// Intentos fallidos contra este código. Un código de 6 dígitos son un millón
  /// de combinaciones: con 30 minutos de vigencia y sin tope, se fuerza.
  attempts  Int                 @default(0)
  createdAt DateTime            @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, type])
  @@map("credential_tokens")
}

enum CredentialTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  /// Alta de un miembro del equipo: el invitado elige su propia contraseña.
  INVITATION
}

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @unique @map("user_id") @db.Uuid
  name       String
  email      String?
  phone      String?
  documentId String?  @map("document_id")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  lockers   Locker[]
  shipments Shipment[]

  @@index([tenantId])
  @@map("customers")
}

model Shipment {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  customerId     String?        @map("customer_id") @db.Uuid
  trackingNumber String         @unique @map("tracking_number")
  type           ShipmentType   @default(LOCAL)
  status         ShipmentStatus @default(CREATED)

  recipientName  String  @map("recipient_name")
  recipientPhone String? @map("recipient_phone")

  originLabel        String? @map("origin_label")
  originCountry      String? @map("origin_country")
  destinationLabel   String? @map("destination_label")
  destinationCountry String? @map("destination_country")
  destinationLat     Float?  @map("destination_lat")
  destinationLng     Float?  @map("destination_lng")

  weightKg      Decimal? @map("weight_kg") @db.Decimal(10, 3)
  declaredValue Decimal? @map("declared_value") @db.Decimal(12, 2)
  codAmount     Decimal? @map("cod_amount") @db.Decimal(12, 2)
  currency      String   @default("USD")

  carrierTrackingNumber String? @map("carrier_tracking_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  legs       ShipmentLeg[]
  events     ShipmentEvent[]
  packages   LockerPackage[]
  customs    CustomsRecord?
  routeStops RouteStop[]
  pods       ProofOfDelivery[]
  payments   Payment[]
  notifications Notification[]
  manifestItems ManifestItem[]
  exceptions    Exception[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
  @@map("shipments")
}

model ShipmentLeg {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  shipmentId       String    @map("shipment_id") @db.Uuid
  sequence         Int
  mode             LegMode
  originLabel      String    @map("origin_label")
  destinationLabel String    @map("destination_label")
  originLat        Float?    @map("origin_lat")
  originLng        Float?    @map("origin_lng")
  destinationLat   Float?    @map("destination_lat")
  destinationLng   Float?    @map("destination_lng")
  status           LegStatus @default(PENDING)
  carrier          String?
  carrierId        String?   @map("carrier_id") @db.Uuid
  externalTracking String?   @map("external_tracking")
  etaAt            DateTime? @map("eta_at")
  departedAt       DateTime? @map("departed_at")
  arrivedAt        DateTime? @map("arrived_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  carrierRef  Carrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)

  @@unique([shipmentId, sequence])
  @@index([tenantId])
  @@index([shipmentId])
  @@index([carrierId])
  @@map("shipment_legs")
}

model ShipmentEvent {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  shipmentId      String         @map("shipment_id") @db.Uuid
  legId           String?        @map("leg_id") @db.Uuid
  status          ShipmentStatus
  description     String?
  locationLabel   String?        @map("location_label")
  lat             Float?
  lng             Float?
  createdByUserId String?        @map("created_by_user_id") @db.Uuid
  occurredAt      DateTime       @default(now()) @map("occurred_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

model Carrier {
  id                  String      @id @default(uuid()) @db.Uuid
  tenantId            String      @map("tenant_id") @db.Uuid
  name                String
  code                String
  type                CarrierType @default(COURIER)
  trackingUrlTemplate String?     @map("tracking_url_template")
  active              Boolean     @default(true)
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legs   ShipmentLeg[]
  trips  Trip[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("carriers")
}

model Locker {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  customerId    String?      @map("customer_id") @db.Uuid
  code          String
  customerName  String       @map("customer_name")
  customerEmail String?      @map("customer_email")
  customerPhone String?      @map("customer_phone")
  addressLine1  String       @map("address_line1")
  addressLine2  String?      @map("address_line2")
  city          String
  state         String
  postalCode    String       @map("postal_code")
  country       String       @default("US")
  status        LockerStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  packages LockerPackage[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([customerId])
  @@map("lockers")
}

model LockerPackage {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  lockerId         String        @map("locker_id") @db.Uuid
  shipmentId       String?       @map("shipment_id") @db.Uuid
  externalTracking String?       @map("external_tracking")
  merchant         String?
  description      String?
  weightKg         Decimal?      @map("weight_kg") @db.Decimal(10, 3)
  declaredValue    Decimal?      @map("declared_value") @db.Decimal(12, 2)
  currency         String        @default("USD")
  status           PackageStatus @default(PRE_ALERTED)
  preAlertedAt     DateTime      @default(now()) @map("pre_alerted_at")
  receivedAt       DateTime?     @map("received_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  /// --- Prealerta: lo que el cliente sabe antes de que el bulto exista -------
  /// Tienda y número de orden. Sin esto, un paquete que llega sin etiqueta
  /// legible no se puede casar con nada y acaba en el montón de «sin dueño».
  storeName        String?   @map("store_name")
  orderNumber      String?   @map("order_number")
  /// Cuándo dice el comercio que llega. Es lo que permite avisar de un paquete
  /// que se retrasó, en vez de esperar a que el cliente pregunte.
  estimatedArrival DateTime? @map("estimated_arrival")
  /// Qué es. Lo declara el cliente y lo confirma quien recibe; la fase 3 lo
  /// usará para decidir qué documentos exige la aduana.
  category         PackageCategory?
  /// Factura de compra. La aduana la pide y el cliente la tiene el día que
  /// compra, no el día que el paquete llega a la bodega.
  invoiceFileId    String?   @map("invoice_file_id") @db.Uuid

  /// --- Recepción: lo que la bodega mide -------------------------------------
  lengthCm Decimal? @map("length_cm") @db.Decimal(8, 2)
  widthCm  Decimal? @map("width_cm") @db.Decimal(8, 2)
  heightCm Decimal? @map("height_cm") @db.Decimal(8, 2)
  /// Los TRES pesos se conservan, y no es redundancia:
  ///   - `weightKg` (el real) es lo que cobra la aerolínea.
  ///   - `volumetricWeightKg` justifica el cobro ante el cliente que reclama
  ///     que su caja de almohadas pesa dos kilos.
  ///   - `chargeableWeightKg` es el máximo de los dos, CONGELADO al recibir:
  ///     recalcularlo después cambiaría facturas ya emitidas si alguien toca el
  ///     divisor volumétrico del tenant.
  volumetricWeightKg Decimal? @map("volumetric_weight_kg") @db.Decimal(10, 3)
  chargeableWeightKg Decimal? @map("chargeable_weight_kg") @db.Decimal(10, 3)
  /// Bultos dentro del mismo envío del comercio (una compra, tres cajas).
  pieces           Int              @default(1)
  condition        PackageCondition @default(GOOD)
  /// Quién lo recibió. Un daño que aparece después necesita saber quién lo tuvo
  /// delante, y sin esto la respuesta es «alguien de bodega».
  receivedByUserId String?          @map("received_by_user_id") @db.Uuid
  /// En qué bodega se recibió. Quedó pendiente en la fase 1 esperando a que
  /// `Warehouse` existiera: una columna nulable que nadie llena es
  /// indistinguible de un olvido.
  warehouseId      String?          @map("warehouse_id") @db.Uuid

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locker   Locker    @relation(fields: [lockerId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  invoice   FileObject? @relation("FacturaDePaquete", fields: [invoiceFileId], references: [id], onDelete: SetNull)
  warehouse Warehouse?  @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  photos    PackagePhoto[]
  exceptions Exception[]

  @@index([tenantId])
  @@index([lockerId])
  @@index([shipmentId])
  @@map("locker_packages")
}

/// Una bodega o sucursal física.
///
/// Antes «Miami» y «bodega HN» eran cadenas de texto dentro de `originLabel`.
/// Con una fila detrás se puede filtrar, contar, y —lo que hace falta para el
/// cotejo— decir contra qué bodega se está contando lo que llegó.
model Warehouse {
  id       String        @id @default(uuid()) @db.Uuid
  tenantId String        @map("tenant_id") @db.Uuid
  /// Corto y legible: MIA-01, SPS-01. Es lo que se dice por radio.
  code     String
  name     String
  type     WarehouseType @default(ORIGIN)
  country  String
  city     String?
  addressLine String?    @map("address_line")
  /// Si el cliente puede venir a retirar aquí. Lo necesita el modo de entrega
  /// de la fase 5, y se declara desde ya para no tener que migrar después.
  allowsPickup Boolean   @default(false) @map("allows_pickup")
  active    Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  packages LockerPackage[]
  tripsFrom Trip[]         @relation("BodegaOrigen")
  tripsTo   Trip[]         @relation("BodegaDestino")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

/// El vuelo (o el viaje) en el que se mueve la carga.
///
/// Va por encima del manifiesto y no dentro: un mismo vuelo puede llevar varios
/// manifiestos, y un manifiesto se prepara antes de saber en qué vuelo sale.
model Trip {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  carrierId    String?    @map("carrier_id") @db.Uuid
  /// Número de vuelo o de viaje. Es lo que se le dice a la aduana.
  flightNumber String?    @map("flight_number")
  originWarehouseId      String? @map("origin_warehouse_id") @db.Uuid
  destinationWarehouseId String? @map("destination_warehouse_id") @db.Uuid
  departureAt  DateTime?  @map("departure_at")
  arrivalAt    DateTime?  @map("arrival_at")
  status       TripStatus @default(PLANNED)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  carrier     Carrier?   @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  origin      Warehouse? @relation("BodegaOrigen", fields: [originWarehouseId], references: [id], onDelete: SetNull)
  destination Warehouse? @relation("BodegaDestino", fields: [destinationWarehouseId], references: [id], onDelete: SetNull)
  manifests   Manifest[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("trips")
}

/// El manifiesto de carga: la guía madre y el detalle de sus guías hijas.
///
/// Esto es lo que faltaba para que «consolidación» dejara de significar dos
/// cosas. Juntar tres paquetes de un cliente en un envío ya existía; agrupar
/// ciento cincuenta bultos de todos los clientes en el vuelo del martes es esto.
model Manifest {
  id       String         @id @default(uuid()) @db.Uuid
  tenantId String         @map("tenant_id") @db.Uuid
  /// El número que exige Aduanas. Único por empresa.
  number   String
  tripId   String?        @map("trip_id") @db.Uuid
  status   ManifestStatus @default(DRAFT)

  /// Totales DECLARADOS. Se calculan al cerrar el manifiesto, sumando sus
  /// líneas, y se congelan: son lo que se transmitió, y el cotejo compara
  /// contra ellos. Recalcularlos al leer haría que añadir una línea después
  /// cambiara retroactivamente lo que se declaró.
  totalPieces   Int     @default(0) @map("total_pieces")
  totalWeightKg Decimal @default(0) @map("total_weight_kg") @db.Decimal(12, 3)

  /// Totales CONTADOS al recibir. Nulos hasta que alguien cotea.
  receivedPieces   Int?     @map("received_pieces")
  receivedWeightKg Decimal? @map("received_weight_kg") @db.Decimal(12, 3)
  reconciledAt     DateTime? @map("reconciled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip       Trip?          @relation(fields: [tripId], references: [id], onDelete: SetNull)
  items      ManifestItem[]
  exceptions Exception[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("manifests")
}

/// Una guía hija dentro del manifiesto.
///
/// Los campos no son decorativos: número de guía, bultos, peso, descripción,
/// consignatario, flete y valor FOB son los que el procedimiento de courier pide
/// que se detallen. Se COPIAN del envío al añadir la línea en vez de leerse por
/// relación, porque el manifiesto es un documento: tiene que seguir diciendo lo
/// que decía el día que se transmitió, aunque el envío cambie después.
model ManifestItem {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  manifestId String @map("manifest_id") @db.Uuid
  shipmentId String @map("shipment_id") @db.Uuid

  pieces      Int      @default(1)
  weightKg    Decimal  @db.Decimal(10, 3)
  description String?
  consignee   String?
  freightAmount Decimal? @map("freight_amount") @db.Decimal(12, 2)
  fobValue      Decimal? @map("fob_value") @db.Decimal(12, 2)
  currency      String   @default("USD")

  /// Lo contado para ESTA línea. El cotejo por línea es lo que permite decir
  /// qué guía falta, en vez de solo que faltan tres bultos de ciento cincuenta.
  receivedPieces   Int?     @map("received_pieces")
  receivedWeightKg Decimal? @map("received_weight_kg") @db.Decimal(10, 3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manifest Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  /// Un envío no puede ir dos veces en el mismo manifiesto.
  @@unique([manifestId, shipmentId])
  @@index([tenantId])
  @@index([manifestId])
  @@map("manifest_items")
}

/// Algo que salió mal y hay que resolver.
///
/// **Es una entidad y no un estado, y ahí está todo el punto.** Un envío puede
/// estar a la vez «en aduana» y «con documentación pendiente»; con el problema
/// metido en `ShipmentStatus` habría que elegir cuál de las dos cosas contar, y
/// la operación real necesita las dos. Además cuelga de lo que sea —envío,
/// bulto o manifiesto—, y un estado solo puede vivir en una tabla.
model Exception {
  id       String            @id @default(uuid()) @db.Uuid
  tenantId String            @map("tenant_id") @db.Uuid
  type     ExceptionType
  status   ExceptionStatus   @default(OPEN)
  severity ExceptionSeverity @default(MEDIUM)

  /// A qué se refiere. Los tres son opcionales y al menos uno debería venir;
  /// no se fuerza en el esquema porque una excepción manual puede no colgar de
  /// nada todavía —«llegó un bulto sin etiqueta»—.
  shipmentId String? @map("shipment_id") @db.Uuid
  packageId  String? @map("package_id") @db.Uuid
  manifestId String? @map("manifest_id") @db.Uuid

  description String
  /// Qué se esperaba y qué había. Texto y no números: sirve igual para «100
  /// bultos / 1000 kg» que para «factura comercial», y una excepción que solo
  /// admitiera cifras no podría describir la mitad de los casos.
  expectedValue String? @map("expected_value")
  actualValue   String? @map("actual_value")

  assignedToUserId String?   @map("assigned_to_user_id") @db.Uuid
  createdByUserId  String?   @map("created_by_user_id") @db.Uuid
  resolution       String?
  resolvedAt       DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment Shipment?      @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  package  LockerPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  manifest Manifest?      @relation(fields: [manifestId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([shipmentId])
  @@map("exceptions")
}

/// Un archivo subido al almacenamiento de objetos.
///
/// La prueba de entrega no necesitó esta tabla —tiene dos huecos fijos, firma y
/// foto, y dos columnas de clave bastaban—. Aquí sí hace falta: un bulto lleva
/// N fotos y no se sabe cuántas de antemano, así que la relación necesita filas.
///
/// **Es metadato, no el archivo.** El binario vive en MinIO bajo `key`. Esta
/// fila existe para poder listar, contar, atribuir y borrar sin recorrer el
/// bucket, y para que un reclamo pueda apoyarse en el tamaño y el tipo que se
/// registraron al subir.
model FileObject {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// Clave en el bucket. Única: dos filas apuntando al mismo objeto harían que
  /// borrar una dejara a la otra señalando a la nada.
  key          String   @unique
  contentType  String   @map("content_type")
  sizeBytes    Int      @map("size_bytes")
  /// Nombre con el que el usuario lo subió. Solo para mostrar: la ruta real es
  /// un UUID, precisamente para que este nombre no forme parte de ella.
  originalName String?  @map("original_name")
  uploadedByUserId String? @map("uploaded_by_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  packagePhotos PackagePhoto[]
  facturaDe     LockerPackage[] @relation("FacturaDePaquete")

  @@index([tenantId])
  @@map("file_objects")
}

/// Foto de un bulto en la recepción.
///
/// Es lo que convierte «llegó dañado» en una discusión con datos. Sin foto al
/// recibir, un daño reclamado tres días después no se puede atribuir a nadie: ni
/// al transportista, ni a la bodega, ni al cliente.
model PackagePhoto {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  packageId String            @map("package_id") @db.Uuid
  fileId    String            @map("file_id") @db.Uuid
  type      PackagePhotoType  @default(EXTERIOR)
  createdAt DateTime          @default(now()) @map("created_at")

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package LockerPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  file    FileObject    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([packageId])
  @@map("package_photos")
}

model CustomsRecord {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  shipmentId    String        @unique @map("shipment_id") @db.Uuid
  status        CustomsStatus @default(PENDING)
  declaredValue Decimal?      @map("declared_value") @db.Decimal(12, 2)
  dutyAmount    Decimal?      @map("duty_amount") @db.Decimal(12, 2)
  taxAmount     Decimal?      @map("tax_amount") @db.Decimal(12, 2)
  handlingFee   Decimal?      @map("handling_fee") @db.Decimal(12, 2)
  totalCharges  Decimal?      @map("total_charges") @db.Decimal(12, 2)
  currency      String        @default("USD")
  notes         String?
  clearedAt     DateTime?     @map("cleared_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("customs_records")
}

model Zone {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  code        String
  description String?
  centerLat   Float?   @map("center_lat")
  centerLng   Float?   @map("center_lng")
  radiusKm    Float?   @map("radius_km")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rates   Rate[]
  drivers Driver[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("zones")
}

model Rate {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  zoneId    String?  @map("zone_id") @db.Uuid
  name      String
  baseFee   Decimal  @default(0) @map("base_fee") @db.Decimal(12, 2)
  perKg     Decimal  @default(0) @map("per_kg") @db.Decimal(12, 2)
  perKm     Decimal  @default(0) @map("per_km") @db.Decimal(12, 2)
  minCharge Decimal  @default(0) @map("min_charge") @db.Decimal(12, 2)
  currency  String   @default("HNL")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zone   Zone?  @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([zoneId])
  @@map("rates")
}

model Driver {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  userId       String?      @unique @map("user_id") @db.Uuid
  zoneId       String?      @map("zone_id") @db.Uuid
  name         String
  phone        String?
  vehicleType  VehicleType  @default(MOTORCYCLE) @map("vehicle_type")
  vehiclePlate String?      @map("vehicle_plate")
  status       DriverStatus @default(OFFLINE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  zone     Zone?     @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  routes   Route[]
  payments Payment[]

  @@index([tenantId])
  @@index([zoneId])
  @@map("drivers")
}

model Route {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  driverId      String      @map("driver_id") @db.Uuid
  code          String
  status        RouteStatus @default(PLANNED)
  scheduledDate DateTime    @map("scheduled_date") @db.Date
  startedAt     DateTime?   @map("started_at")
  completedAt   DateTime?   @map("completed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driver Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  stops  RouteStop[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([driverId])
  @@map("routes")
}

model RouteStop {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  routeId      String     @map("route_id") @db.Uuid
  shipmentId   String     @map("shipment_id") @db.Uuid
  sequence     Int
  type         StopType   @default(DELIVERY)
  status       StopStatus @default(PENDING)
  addressLabel String?    @map("address_label")
  lat          Float?
  lng          Float?
  notes        String?
  arrivedAt    DateTime?  @map("arrived_at")
  completedAt  DateTime?  @map("completed_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route    Route            @relation(fields: [routeId], references: [id], onDelete: Cascade)
  shipment Shipment         @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  pod      ProofOfDelivery?

  @@unique([routeId, sequence])
  @@index([tenantId])
  @@index([routeId])
  @@index([shipmentId])
  @@map("route_stops")
}

model ProofOfDelivery {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  shipmentId    String    @map("shipment_id") @db.Uuid
  routeStopId   String?   @unique @map("route_stop_id") @db.Uuid
  receivedBy    String?   @map("received_by")
  /// Clave del objeto en el almacenamiento, NO una URL.
  ///
  /// Antes eran `signature_url`/`photo_url` y aceptaban cualquier URL que
  /// mandara quien llamaba: nadie las llenaba —no había forma de subir un
  /// archivo— y, de haberlas llenado, el panel habría renderizado un `<img>`
  /// apuntando a donde el cliente quisiera. Ahora se guarda la clave que
  /// devuelve la subida firmada y la URL se firma al leer, con vigencia corta.
  signatureKey  String?   @map("signature_key")
  photoKey      String?   @map("photo_key")
  failureReason String?   @map("failure_reason")
  lat           Float?
  lng           Float?
  capturedAt    DateTime  @default(now()) @map("captured_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment  Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  routeStop RouteStop? @relation(fields: [routeStopId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([shipmentId])
  @@map("proof_of_deliveries")
}

model Payment {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  shipmentId          String?        @map("shipment_id") @db.Uuid
  type                PaymentType    @default(COD)
  amount              Decimal        @db.Decimal(12, 2)
  currency            String         @default("HNL")
  method              PaymentMethod?
  status              PaymentStatus  @default(PENDING)
  collectedByDriverId String?        @map("collected_by_driver_id") @db.Uuid
  reference           String?
  collectedAt         DateTime?      @map("collected_at")
  remittedAt          DateTime?      @map("remitted_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  driver   Driver?   @relation(fields: [collectedByDriverId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([shipmentId])
  @@map("payments")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
