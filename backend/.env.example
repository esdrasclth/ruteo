# Migrations / admin connection (Postgres superuser). Used by Prisma CLI.
DATABASE_URL="postgresql://ruteo:ruteo@localhost:5544/ruteo?schema=public"

# Runtime connection (non-superuser app role, subject to RLS). Used by the app.
DATABASE_URL_APP="postgresql://ruteo_app:ruteo_app@localhost:5544/ruteo?schema=public"

# App
PORT=3000
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="900s"
JWT_REFRESH_TTL="7d"

# --- Identidad (ZITADEL) ------------------------------------------------------
# Las credenciales viven aquí. Obligatorias: sin ellas la app no autentica.

ZITADEL_ISSUER="https://auth.brandsofts.com"
# Cuenta de servicio con permisos de Management API (PAT o client credentials).
ZITADEL_SERVICE_TOKEN=""
# Proyecto cuyos roles se mapean a los `Role` de Ruteo.
ZITADEL_PROJECT_ID=""

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Namespace de las colas BullMQ en Redis. Cámbialo si varios entornos comparten
# la misma instancia de Redis, para que no se pisen los jobs.
QUEUE_PREFIX=bull

# --- Correo saliente ----------------------------------------------------------
# Sin clave, los codigos de restablecimiento y verificacion salen por el log en
# vez de enviarse. La instancia de ZITADEL ya usa Resend; aqui hace falta su
# clave de API para que Ruteo mande sus propios correos.
RESEND_API_KEY=""
MAIL_FROM="Ruteo <no-reply@brandsofts.com>"

# URL del panel, para el enlace de verificacion que va en el correo.
PANEL_URL="http://localhost:3001"

# Secreto de los tokens del panel de plataforma (distinto del de tenant).
PLATFORM_JWT_SECRET="cambiar-esto-plataforma-1739517683"
