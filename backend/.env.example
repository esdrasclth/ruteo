# Copia este archivo a `.env` y rellena lo que falte.
#
# NINGÚN secreto de aquí sirve tal cual en producción. El arranque con
# NODE_ENV=production comprueba que los hayas cambiado (ver
# `src/config/env.validation.ts`) y se niega a levantar si detecta los de
# ejemplo, uno corto, o dos iguales entre sí.
#
# Genera cada uno con:  openssl rand -base64 48

# --- Base de datos ------------------------------------------------------------
# Migraciones / administración (rol dueño del esquema). Lo usa el CLI de Prisma
# y el módulo de plataforma, que es el único que ve todas las empresas.
DATABASE_URL="postgresql://ruteo:ruteo@localhost:5544/ruteo?schema=public"

# Runtime de la aplicación (rol `ruteo_app`, NOBYPASSRLS: sujeto a RLS).
DATABASE_URL_APP="postgresql://ruteo_app:ruteo_app@localhost:5544/ruteo?schema=public"

# OJO en producción: la migración `20260712203500_rls_setup` crea el rol
# `ruteo_app` con la contraseña `ruteo_app` escrita en el SQL. En un despliegue
# nuevo sobrevive tal cual. Hay que rotarla a mano DESPUÉS de migrar:
#
#   psql -c "ALTER ROLE ruteo_app PASSWORD '<generada>'"
#   psql -c "ALTER ROLE ruteo     PASSWORD '<generada>'"
#
# y actualizar las dos cadenas de arriba. Ver docs/despliegue-vps.md.

# --- App ----------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- JWT ----------------------------------------------------------------------
# Los tres secretos deben ser DISTINTOS entre sí.
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="900s"
JWT_REFRESH_TTL="7d"

# Firma los tokens del panel de plataforma, que ve TODAS las empresas.
# Es el secreto más peligroso del sistema: compartirlo con los de tenant
# convierte cualquier falsificación de token de empresa en una de superadmin.
PLATFORM_JWT_SECRET="change-me-platform"

# --- Identidad (ZITADEL) ------------------------------------------------------
# Las credenciales viven aquí. Obligatorias: sin ellas la app no autentica.

ZITADEL_ISSUER="https://auth.brandsofts.com"
# Cuenta de servicio con permisos de Management API (PAT o client credentials).
ZITADEL_SERVICE_TOKEN=""
# Proyecto cuyos roles se mapean a los `Role` de Ruteo.
ZITADEL_PROJECT_ID=""

# --- Redis --------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Debe coincidir con la del docker-compose. Obligatoria en producción.
REDIS_PASSWORD=

# Namespace de las colas BullMQ en Redis. Cámbialo si varios entornos comparten
# la misma instancia de Redis, para que no se pisen los jobs.
QUEUE_PREFIX=bull

# --- Correo saliente ----------------------------------------------------------
# Sin clave, los codigos de restablecimiento y verificacion salen por el log en
# vez de enviarse. La instancia de ZITADEL ya usa Resend; aqui hace falta su
# clave de API para que Ruteo mande sus propios correos.
RESEND_API_KEY=""
MAIL_FROM="Ruteo <no-reply@brandsofts.com>"

# URL del panel, para el enlace de verificacion que va en el correo.
PANEL_URL="http://localhost:3001"

# --- Webhooks salientes -------------------------------------------------------
# Permite endpoints en http:// y hacia direcciones privadas. SOLO para
# desarrollo (probar contra un servidor local). En producción déjalo en `false`
# o sin definir: con `true`, un tenant puede apuntar un webhook al metadata del
# proveedor de nube o a tus servicios internos.
WEBHOOKS_PERMITIR_DESTINOS_PRIVADOS=false

# --- Almacenamiento de archivos (S3 / MinIO) ----------------------------------
# Fotos de bodega, facturas, declaraciones, firmas de entrega y evidencia de
# reclamos. Sin configurar, el modulo queda dormido y el resto funciona igual;
# lo que NO se admite es configurarlo a medias (el arranque lo rechaza).
#
# S3_ENDPOINT es la API S3. La consola web de MinIO es OTRO dominio y otra
# aplicacion: apuntar aqui a la consola falla con un error de XML que no dice
# por que. S3_PUBLIC_URL es por donde se sirven los archivos al navegador.
S3_ENDPOINT=""
S3_PUBLIC_URL=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="ruteo"
S3_REGION="us-east-1"
# MinIO sirve los buckets como ruta (/bucket/clave), no como subdominio.
S3_FORCE_PATH_STYLE=true
